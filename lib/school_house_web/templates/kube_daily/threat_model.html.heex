            </div>

            <!-- Code Preview Snippet -->
            <pre style="margin: 0.5rem 0 0 0; padding: 0.6rem; background: #0b132b; color: #38bdf8; border-radius: 0.375rem; font-size: 0.72rem; line-height: 1.45; overflow-x: auto; border: 1px solid #1e293b;"><code id="card-code-4">pattern:
  spec:
    automountServiceAccountToken: false</code></pre>

            <div style="margin-top: 0.65rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
              <span style="font-size: 0.7rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-weight: 600;">CIS § 5.1.5</span>
              <span style="font-size: 0.7rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-weight: 600;">MITRE T1552.007</span>
