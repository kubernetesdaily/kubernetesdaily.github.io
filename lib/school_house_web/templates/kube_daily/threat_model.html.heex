<section class="kube-page-header">
  <div class="kube-page-header-content">
    <div class="kube-section-pill">Interactive Visual Architecture</div>
    <h1 class="kube-page-title">Kubernetes Threat Model &amp; Attack Chains</h1>
    <p class="kube-page-subtitle">
      An authoritative, interactive reference architecture and threat modeling engine for enterprise Kubernetes. Inspect trust boundaries, threat actors, threat objects, attack vectors, and production hardening policies with real-time deep-linking, multi-layer abstraction depth, traffic flow overlays, and production-tested YAML, Shell, Falco eBPF, and CIS compliance inspectors.
    </p>

    <div class="kube-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); margin-top: 1.5rem; gap: 0.75rem;">
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">4</div>
        <div class="kube-stat-label">Diagram Sheets</div>
      </div>
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">L0–L3</div>
        <div class="kube-stat-label">Depth Levels</div>
      </div>
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">TA01–07</div>
        <div class="kube-stat-label">Threat Actors</div>
      </div>
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">TO01–32</div>
        <div class="kube-stat-label">Threat Objects</div>
      </div>
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">AV01–32</div>
        <div class="kube-stat-label">Attack Vectors</div>
      </div>
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">C01–30</div>
        <div class="kube-stat-label">Controls</div>
      </div>
      <div class="kube-stat-card" style="padding: 0.75rem 1rem;">
        <div class="kube-stat-value" style="font-size: 1.5rem;">P1–P6</div>
        <div class="kube-stat-label">Attack Chains</div>
      </div>
    </div>
  </div>
</section>

<div class="kube-shell threat-model-page" style="max-width: 1440px; margin: 0 auto; padding: 1.25rem 1rem;">

  <!-- Interactive Viewport Toolbar -->
  <div class="kube-card threat-model-toolbar" style="margin-bottom: 1rem; padding: 0.85rem 1rem; border-radius: 0.75rem; background: var(--tm-bg-card); border: 1px solid var(--tm-border); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);">
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">

      <!-- Top Row: Sheets, Search & View Controls -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center;">

        <!-- Sheet Switcher Tabs (4 Sheets) -->
        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;" role="tablist">
          <button id="btn-sheet-cluster" class="kube-button" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem; border-radius: 0.5rem; cursor: pointer;" onclick="switchSheet('cluster')">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; margin-right: 6px;"></span>
            01 · Master Threat Register
          </button>
          <button id="btn-sheet-attack-chains" class="kube-button kube-button-secondary" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem; border-radius: 0.5rem; cursor: pointer;" onclick="switchSheet('attack-chains')">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; margin-right: 6px;"></span>
            02 · Attack Chains &amp; Narratives
          </button>
          <button id="btn-sheet-security-architecture" class="kube-button kube-button-secondary" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem; border-radius: 0.5rem; cursor: pointer;" onclick="switchSheet('security-architecture')">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; margin-right: 6px;"></span>
            03 · Layered Reference Architecture
          </button>
          <button id="btn-sheet-flow-analysis" class="kube-button kube-button-secondary" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem; border-radius: 0.5rem; cursor: pointer;" onclick="switchSheet('flow-analysis')">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #a855f7; margin-right: 6px;"></span>
            04 · Packet &amp; Flow Analysis
          </button>
        </div>

        <!-- Live Search Box with Autocomplete Dropdown -->
        <div style="display: flex; align-items: center; gap: 0.4rem; position: relative;">
          <div style="position: relative; display: flex; align-items: center;">
            <input id="diagram-search-input" type="text" placeholder="Search (e.g. etcd, TA01, runc, P1, C01)..."
                   style="font-size: 0.8125rem; padding: 0.4rem 2rem 0.4rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--tm-border-strong); width: 260px; background: var(--tm-bg-input); color: var(--tm-text-head);"
                   oninput="handleSearch(this.value)" onfocus="handleSearch(this.value)" />
            <button id="search-clear-btn" onclick="clearSearch()" style="position: absolute; right: 8px; border: none; background: transparent; cursor: pointer; color: #94a3b8; font-size: 0.8125rem; display: none;">✕</button>
          </div>
          <span id="search-results-badge" style="font-size: 0.75rem; color: var(--tm-text-muted); font-weight: 600; display: none;">0 matches</span>

          <!-- Autocomplete Dropdown Menu -->
          <div id="search-autocomplete-dropdown" style="display: none; position: absolute; left: 0; top: 100%; margin-top: 4px; width: 340px; max-height: 320px; overflow-y: auto; background: var(--tm-dropdown-bg); border: 1px solid var(--tm-border-strong); border-radius: 0.5rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.25); z-index: 60;"></div>
        </div>

        <!-- Zoom & Viewport Controls -->
        <div style="display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap;">
          <button onclick="adjustZoom(-0.15)" class="kube-button kube-button-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;" title="Zoom Out (-)">−</button>
          <span id="zoom-indicator" style="font-size: 0.75rem; font-weight: 600; color: var(--tm-text-muted); min-width: 44px; text-align: center;">100%</span>
          <button onclick="adjustZoom(0.15)" class="kube-button kube-button-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;" title="Zoom In (+)">+</button>
          <button onclick="resetZoom()" class="kube-button kube-button-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;" title="Reset View (0)">Reset</button>
          <button onclick="toggleFullscreen()" class="kube-button kube-button-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;" title="Toggle Fullscreen (f)">⛶</button>
          <button onclick="toggleShortcutsModal()" class="kube-button kube-button-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;" title="Keyboard Shortcuts (?)">⌨ ?</button>

          <!-- Download Dropdown -->
          <div style="position: relative; display: inline-block;">
            <button onclick="toggleDownloadMenu()" class="kube-button kube-button-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;">
              ⬇ Export ▾
            </button>
            <div id="download-dropdown-menu" style="display: none; position: absolute; right: 0; top: 100%; margin-top: 4px; background: var(--tm-dropdown-bg); border: 1px solid var(--tm-border-strong); border-radius: 0.5rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.25); min-width: 220px; z-index: 50;">
              <div style="padding: 0.35rem 0.85rem; font-size: 0.7rem; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Draw.io XML Sources</div>
              <a href="/kubedaily/diagrams/kubernetes-threat-model.drawio" download="kubernetes-threat-model.drawio" style="display: block; padding: 0.4rem 0.85rem; font-size: 0.775rem; color: #1e293b; text-decoration: none; border-bottom: 1px solid #f1f5f9;">
                📄 Complete 4-Sheet (.drawio)
              </a>
              <a href="/kubedaily/diagrams/kubernetes-security-architecture.drawio" download="kubernetes-security-architecture.drawio" style="display: block; padding: 0.4rem 0.85rem; font-size: 0.775rem; color: #1e293b; text-decoration: none; border-bottom: 1px solid #f1f5f9;">
                📄 Sheet 03 Standalone (.drawio)
              </a>
              <a href="/kubedaily/diagrams/kubernetes-flow-analysis.drawio" download="kubernetes-flow-analysis.drawio" style="display: block; padding: 0.4rem 0.85rem; font-size: 0.775rem; color: #1e293b; text-decoration: none; border-bottom: 1px solid #f1f5f9;">
                📄 Sheet 04 Standalone (.drawio)
              </a>
              <div style="padding: 0.35rem 0.85rem; font-size: 0.7rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-top: 0.25rem;">Active Sheet Render</div>
              <a id="btn-download-svg" href="/kubedaily/images/k8s-threat-model-cluster.svg" download="cluster.svg" style="display: block; padding: 0.4rem 0.85rem; font-size: 0.775rem; color: #1e293b; text-decoration: none; border-bottom: 1px solid #f1f5f9;">
                🎨 Active Sheet Vector (.svg)
              </a>
              <a id="btn-download-png" href="/kubedaily/images/k8s-threat-model-cluster.png" download="cluster.png" style="display: block; padding: 0.4rem 0.85rem; font-size: 0.775rem; color: #1e293b; text-decoration: none; border-bottom: 1px solid #f1f5f9;">
                🖼️ Active Sheet Retina (.png)
              </a>
              <div style="padding: 0.35rem 0.85rem; font-size: 0.7rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-top: 0.25rem;">Threat Catalog Data</div>
              <button onclick="exportCatalogJson()" style="width: 100%; text-align: left; background: none; border: none; padding: 0.4rem 0.85rem; font-size: 0.775rem; color: #1e293b; cursor: pointer;">
                📦 JSON Threat Catalog
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- Second Row: Depth Levels, Priority Filters & Traffic Flow -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 0.65rem;">

        <!-- Depth / Abstraction Levels -->
        <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 2px;">Depth:</span>
          <div style="display: inline-flex; background: #f1f5f9; border-radius: 0.5rem; padding: 2px;">
            <button id="level-btn-0" onclick="setLevel(0)" class="level-segment-btn active" title="Executive high-level topology">L0 · Boundary</button>
            <button id="level-btn-1" onclick="setLevel(1)" class="level-segment-btn" title="Core Kubernetes services">L1 · Standard</button>
            <button id="level-btn-2" onclick="setLevel(2)" class="level-segment-btn" title="Security controls & attack vectors">L2 · Security</button>
            <button id="level-btn-3" onclick="setLevel(3)" class="level-segment-btn" title="eBPF, syscalls, namespaces & runtime">L3 · Kernel</button>
          </div>
        </div>

        <!-- Priority Filters -->
        <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 2px;">Priority:</span>
          <button id="pri-btn-all" onclick="setPriorityFilter('all')" class="pri-pill-btn active" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">All</button>
          <button id="pri-btn-pri-1" onclick="setPriorityFilter('pri-1')" class="pri-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;" title="Critical cluster compromise risk">🔴 Pri 1</button>
          <button id="pri-btn-pri-2" onclick="setPriorityFilter('pri-2')" class="pri-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #fcd34d; background: #fffbeb; color: #92400e; cursor: pointer;" title="High lateral movement risk">🟠 Pri 2</button>
          <button id="pri-btn-pri-3" onclick="setPriorityFilter('pri-3')" class="pri-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #fde047; background: #fefce8; color: #854d0e; cursor: pointer;" title="Medium operational risk">🟡 Pri 3</button>
          <button id="pri-btn-info" onclick="setPriorityFilter('info')" class="pri-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #a5f3fc; background: #ecfeff; color: #155e75; cursor: pointer;" title="Architecture insight">🔵 Info</button>
        </div>

        <!-- STRIDE Taxonomy Filter -->
        <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 2px;">STRIDE:</span>
          <button id="stride-btn-all" onclick="setStrideFilter('all')" class="stride-pill-btn active" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">All</button>
          <button id="stride-btn-S" onclick="setStrideFilter('S')" class="stride-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #f8fafc; cursor: pointer;" title="Spoofing">S</button>
          <button id="stride-btn-T" onclick="setStrideFilter('T')" class="stride-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #f8fafc; cursor: pointer;" title="Tampering">T</button>
          <button id="stride-btn-R" onclick="setStrideFilter('R')" class="stride-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #f8fafc; cursor: pointer;" title="Repudiation">R</button>
          <button id="stride-btn-I" onclick="setStrideFilter('I')" class="stride-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #f8fafc; cursor: pointer;" title="Information Disclosure">I</button>
          <button id="stride-btn-D" onclick="setStrideFilter('D')" class="stride-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #f8fafc; cursor: pointer;" title="Denial of Service">D</button>
          <button id="stride-btn-E" onclick="setStrideFilter('E')" class="stride-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #f8fafc; cursor: pointer;" title="Elevation of Privilege">E</button>
        </div>

        <!-- Traffic Flow Overlay Selector -->
        <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 2px;">Flow:</span>
          <button id="flow-btn-off" onclick="setTrafficFlow('off')" class="flow-pill-btn active" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Off</button>
          <button id="flow-btn-ingress" onclick="setTrafficFlow('ingress')" class="flow-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #fca5a5; background: #fef2f2; color: #dc2626; cursor: pointer;">🔴 Ingress</button>
          <button id="flow-btn-egress" onclick="setTrafficFlow('egress')" class="flow-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #93c5fd; background: #eff6ff; color: #2563eb; cursor: pointer;">🔵 Egress</button>
          <button id="flow-btn-attack-path" onclick="setTrafficFlow('attack-path')" class="flow-pill-btn" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.375rem; border: 1px solid #f87171; background: #450a0a; color: #fecaca; cursor: pointer;">⚡ Attack</button>
        </div>

      </div>

      <!-- Third Row: Quick Scenario Preset Views (spanning Sheets 1, 2, and 3) -->
      <div style="display: flex; align-items: center; gap: 0.4rem; overflow-x: auto; padding: 0.25rem 0; border-top: 1px solid #f1f5f9;">
        <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; margin-right: 4px;">Preset Views:</span>
        <button class="view-pill-btn active" onclick="applyPresetView('overview')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Cluster Overview</button>
        <button class="view-pill-btn" onclick="applyPresetView('layered-architecture')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8; cursor: pointer;">Layered Architecture</button>
        <button class="view-pill-btn" onclick="applyPresetView('identity-access')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8; cursor: pointer;">Identity &amp; Admin</button>
        <button class="view-pill-btn" onclick="applyPresetView('supply-chain-zone')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8; cursor: pointer;">Supply Chain Zone</button>
        <button class="view-pill-btn" onclick="applyPresetView('worker-isolation')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8; cursor: pointer;">Worker Isolation</button>
        <button class="view-pill-btn" onclick="applyPresetView('api-request-flow')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #e9d5ff; background: #faf5ff; color: #7e22ce; cursor: pointer;">API Request Flow</button>
        <button class="view-pill-btn" onclick="applyPresetView('ingress-egress-flow')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #e9d5ff; background: #faf5ff; color: #7e22ce; cursor: pointer;">Ingress &amp; Egress Flow</button>
        <button class="view-pill-btn" onclick="applyPresetView('supply-chain-flow')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #e9d5ff; background: #faf5ff; color: #7e22ce; cursor: pointer;">CI/CD Supply Flow</button>
        <button class="view-pill-btn" onclick="applyPresetView('escape-containment-flow')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #e9d5ff; background: #faf5ff; color: #7e22ce; cursor: pointer;">Host Breakout &amp; Telemetry</button>
        <button class="view-pill-btn" onclick="applyPresetView('control-plane')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Control Plane</button>
        <button class="view-pill-btn" onclick="applyPresetView('datastore-etcd')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Datastore &amp; KMS</button>
        <button class="view-pill-btn" onclick="applyPresetView('data-plane')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Worker Nodes</button>
        <button class="view-pill-btn" onclick="applyPresetView('threat-actors')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Threat Actors (TA)</button>
        <button class="view-pill-btn" onclick="applyPresetView('kernel-ebpf')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;">Kernel &amp; eBPF</button>
        <button class="view-pill-btn" onclick="applyPresetView('p1-ingress')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;">P1 Ingress</button>
        <button class="view-pill-btn" onclick="applyPresetView('p2-token-abuse')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;">P2 Token Abuse</button>
        <button class="view-pill-btn" onclick="applyPresetView('p3-supply-chain')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;">P3 Supply Chain</button>
        <button class="view-pill-btn" onclick="applyPresetView('p4-container-escape')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;">P4 Host Breakout</button>
        <button class="view-pill-btn" onclick="applyPresetView('p5-cloud-metadata')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;">P5 Cloud IMDS</button>
        <button class="view-pill-btn" onclick="applyPresetView('p6-secrets-compromise')" style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid #fca5a5; background: #fef2f2; color: #991b1b; cursor: pointer;">P6 Secrets Harvest</button>
      </div>

    </div>
  </div>

  <!-- Interactive Stage & Inspector Layout -->
  <div id="diagram-viewport-container" class="kube-card" style="padding: 0; border-radius: 0.75rem; overflow: hidden; background: var(--tm-viewport-bg); border: 1px solid var(--tm-border); position: relative; height: 75vh; min-height: 680px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08); display: flex;">

    <!-- Floating Helper Pill -->
    <div style="position: absolute; top: 12px; left: 16px; z-index: 20; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); color: #f8fafc; font-size: 0.75rem; padding: 0.35rem 0.75rem; border-radius: 9999px; pointer-events: none; display: flex; align-items: center; gap: 6px;">
      <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #38bdf8;"></span>
      <span id="sheet-title-badge">Sheet 1: 01 · Master Threat Register &amp; Cluster Overview</span>
      <span style="opacity: 0.4;">|</span>
      <span id="level-title-badge" style="color: #38bdf8; font-weight: 600;">L0: Boundary</span>
      <span style="opacity: 0.6; margin-left: 4px;">• Click any component to inspect • Drag to pan</span>
    </div>

    <!-- Active Traffic Flow Progression Bar (floats when flow mode is enabled) -->
    <div id="flow-stepper-card" style="display: none; position: absolute; bottom: 16px; left: 16px; z-index: 25; background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(10px); color: #f8fafc; border-radius: 0.5rem; padding: 0.75rem 1rem; border: 1px solid #334155; max-width: 600px; box-shadow: 0 8px 16px rgba(0,0,0,0.3);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
        <span id="flow-stepper-title" style="font-size: 0.8125rem; font-weight: 700; color: #38bdf8;">Active Flow</span>
        <button onclick="setTrafficFlow('off')" style="background: none; border: none; color: #94a3b8; font-size: 0.75rem; cursor: pointer;">✕ Close</button>
      </div>
      <p id="flow-stepper-desc" style="font-size: 0.75rem; color: #cbd5e1; margin: 0 0 0.5rem 0; line-height: 1.4;"></p>
      <div id="flow-stepper-steps" style="display: flex; gap: 0.5rem; overflow-x: auto; font-size: 0.725rem;"></div>
    </div>

    <!-- Scalable Canvas Viewport -->
    <div id="diagram-scroll-pane" style="flex: 1; height: 100%; overflow: auto; cursor: grab; background: var(--tm-canvas-bg); position: relative; padding: 1.5rem;">
      <div id="diagram-scalable-wrapper" style="transform-origin: 0 0; transition: transform 0.15s ease-out; display: inline-block;">
        <div id="diagram-svg-target" style="display: inline-block;">
          <!-- SVG is dynamically inlined here for 100% interactivity -->
          <img id="diagram-image-fallback" src="/kubedaily/images/k8s-threat-model-cluster.svg" alt="Kubernetes Threat Model Diagram" style="display: block; max-width: none;" />
        </div>
      </div>
    </div>

    <!-- Native 5-Tab Inspector Drawer (Slide-Over Panel) -->
    <div id="inspector-drawer" style="width: 470px; height: 100%; background: var(--tm-drawer-bg); border-left: 1px solid var(--tm-border); box-shadow: -4px 0 15px rgba(0, 0, 0, 0.2); position: absolute; right: 0; top: 0; z-index: 30; transform: translateX(100%); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column;">

      <!-- Drawer Header -->
      <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--tm-border); background: var(--tm-drawer-header); display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div style="display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.25rem; flex-wrap: wrap;">
            <span id="drawer-id-badge" class="kube-badge" style="background:#fee2e2;color:#991b1b;font-weight:700;">ID</span>
            <span id="drawer-category-badge" class="kube-badge" style="background:#e0f2fe;color:#0369a1;">Category</span>
            <span id="drawer-priority-badge" class="kube-badge" style="background:#fef3c7;color:#92400e;">Priority</span>
            <span id="drawer-level-badge" class="kube-badge" style="background:#f1f5f9;color:#475569;">Level</span>
          </div>
          <h3 id="drawer-title" style="font-size: 1.15rem; font-weight: 700; color: var(--tm-text-head); margin: 0;">Component Name</h3>
        </div>
        <div style="display: flex; gap: 0.35rem; align-items: center;">
          <button id="drawer-copy-link-btn" onclick="copyDeepLink()" title="Copy Link to this Component" style="padding: 0.35rem 0.5rem; border-radius: 0.375rem; border: 1px solid var(--tm-border-strong); background: var(--tm-bg-card); color: var(--tm-text-head); cursor: pointer; font-size: 0.75rem;">
            🔗 Link
          </button>
          <button onclick="closeInspector()" title="Close Drawer (Esc)" style="padding: 0.35rem 0.6rem; border-radius: 0.375rem; border: none; background: transparent; cursor: pointer; font-size: 1.1rem; color: var(--tm-text-muted);">
            ✕
          </button>
        </div>
      </div>

      <!-- Drawer Tabs (6 Specialized Technical Tabs) -->
      <div style="display: flex; border-bottom: 1px solid var(--tm-border); background: var(--tm-drawer-bg); padding: 0 0.5rem; overflow-x: auto;" role="tablist">
        <button id="tab-btn-overview" class="drawer-tab-btn active" onclick="switchDrawerTab('overview')">
          📘 Overview
        </button>
        <button id="tab-btn-yaml" class="drawer-tab-btn" onclick="switchDrawerTab('yaml')">
          🛡️ Hardening (YAML)
        </button>
        <button id="tab-btn-kyverno" class="drawer-tab-btn" onclick="switchDrawerTab('kyverno')">
          ⚡ Policy-as-Code (Kyverno / CEL / Gatekeeper)
        </button>
        <button id="tab-btn-shell" class="drawer-tab-btn" onclick="switchDrawerTab('shell')">
          🔍 Audit (Shell)
        </button>
        <button id="tab-btn-detection" class="drawer-tab-btn" onclick="switchDrawerTab('detection')">
          🚨 Detection (eBPF)
        </button>
        <button id="tab-btn-compliance" class="drawer-tab-btn" onclick="switchDrawerTab('compliance')">
          📋 Compliance
        </button>
      </div>

      <!-- Drawer Content Scroll Area -->
      <div style="flex: 1; overflow-y: auto; padding: 1.25rem;">

        <!-- Tab 1: Overview -->
        <div id="drawer-content-overview">
          <div style="margin-bottom: 1rem;">
            <h4 style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.35rem;">Overview &amp; Context</h4>
            <p id="drawer-overview-text" style="font-size: 0.875rem; line-height: 1.6; color: #334155; margin: 0;"></p>
          </div>

          <div id="drawer-motive-section" style="margin-bottom: 1rem; padding: 0.75rem; background: #f8fafc; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
            <div style="display: grid; grid-template-columns: 1fr; gap: 0.5rem; font-size: 0.8125rem;">
              <div><strong>Origin:</strong> <span id="drawer-origin-text" style="color: #475569;"></span></div>
              <div><strong>Motive:</strong> <span id="drawer-motive-text" style="color: #475569;"></span></div>
              <div><strong>STRIDE Category:</strong> <span id="drawer-stride-text" style="color: #0284c7; font-weight: 600;"></span></div>
            </div>
          </div>

          <div id="drawer-vectors-section" style="margin-bottom: 1rem; padding: 0.75rem; background: #fef2f2; border-radius: 0.5rem; border: 1px solid #fecaca;">
            <h4 style="font-size: 0.8125rem; font-weight: 700; color: #991b1b; margin-bottom: 0.35rem;">Associated Attack Vectors</h4>
            <ul id="drawer-vectors-list" style="margin: 0; padding-left: 1.25rem; font-size: 0.8125rem; color: #7f1d1d; line-height: 1.5;"></ul>
          </div>
        </div>

        <!-- Tab 2: Hardening YAML -->
        <div id="drawer-content-yaml" style="display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; gap: 0.5rem;">
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Production Hardening Policy</span>
            <div style="display: flex; gap: 0.35rem;">
              <button onclick="downloadCode('drawer-yaml-code', 'hardening-policy.yaml')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">⬇ Download</button>
              <button onclick="copyCode('drawer-yaml-code')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">📋 Copy YAML</button>
            </div>
          </div>
          <pre style="margin: 0; padding: 0.85rem; background: #0f172a; color: #f8fafc; border-radius: 0.5rem; font-size: 0.775rem; line-height: 1.5; overflow-x: auto;"><code id="drawer-yaml-code"></code></pre>
        </div>

        <!-- Tab 3: Policy-as-Code Multi-Engine Guardrail -->
        <div id="drawer-content-kyverno" style="display: none;">
          <!-- 3-Engine Switcher Sub-Bar -->
          <div style="display: flex; gap: 0.35rem; margin-bottom: 0.75rem; background: #0f172a; padding: 0.25rem; border-radius: 0.5rem; border: 1px solid #1e293b;">
            <button id="drawer-engine-btn-kyverno" onclick="switchDrawerPolicyEngine('kyverno')" class="policy-engine-pill active" style="flex: 1; padding: 0.35rem 0.6rem; font-size: 0.75rem; font-weight: 600; border-radius: 0.375rem; border: none; cursor: pointer; transition: all 0.15s ease;">
              ⚡ Kyverno (v1)
            </button>
            <button id="drawer-engine-btn-cel" onclick="switchDrawerPolicyEngine('cel')" class="policy-engine-pill" style="flex: 1; padding: 0.35rem 0.6rem; font-size: 0.75rem; font-weight: 600; border-radius: 0.375rem; border: none; cursor: pointer; transition: all 0.15s ease;">
              ⚙️ In-Tree CEL (1.30+)
            </button>
            <button id="drawer-engine-btn-gatekeeper" onclick="switchDrawerPolicyEngine('gatekeeper')" class="policy-engine-pill" style="flex: 1; padding: 0.35rem 0.6rem; font-size: 0.75rem; font-weight: 600; border-radius: 0.375rem; border: none; cursor: pointer; transition: all 0.15s ease;">
              🛡️ Gatekeeper (Rego)
            </button>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; gap: 0.5rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.4rem;">
              <span id="drawer-policy-engine-label" style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Kyverno ClusterPolicy</span>
              <a id="drawer-policy-docs-link" href="https://kyverno.io" target="_blank" rel="noopener" style="font-size: 0.6875rem; background: #dbeafe; color: #1d4ed8; padding: 0.1rem 0.45rem; border-radius: 0.25rem; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 0.2rem;">kyverno.io ↗</a>
            </div>
            <div style="display: flex; gap: 0.35rem;">
              <button onclick="downloadDrawerPolicy()" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">⬇ Download</button>
              <button onclick="copyCode('drawer-kyverno-code')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">📋 Copy Policy</button>
            </div>
          </div>
          <pre style="margin: 0; padding: 0.85rem; background: #0b132b; color: #38bdf8; border-radius: 0.5rem; font-size: 0.775rem; line-height: 1.5; overflow-x: auto; border: 1px solid #1e293b;"><code id="drawer-kyverno-code"></code></pre>
        </div>

        <!-- Tab 4: Audit Shell -->
        <div id="drawer-content-shell" style="display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; gap: 0.5rem;">
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Validation &amp; Verification CLI</span>
            <div style="display: flex; gap: 0.35rem;">
              <button onclick="downloadCode('drawer-shell-code', 'audit-script.sh')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">⬇ Download</button>
              <button onclick="copyCode('drawer-shell-code')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">📋 Copy Shell</button>
            </div>
          </div>
          <pre style="margin: 0; padding: 0.85rem; background: #0f172a; color: #38bdf8; border-radius: 0.5rem; font-size: 0.775rem; line-height: 1.5; overflow-x: auto;"><code id="drawer-shell-code"></code></pre>
        </div>

        <!-- Tab 4: Detection (Falco / eBPF / Audit Log) -->
        <div id="drawer-content-detection" style="display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; gap: 0.5rem;">
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">eBPF / Falco / Audit Signature</span>
            <div style="display: flex; gap: 0.35rem;">
              <button onclick="downloadCode('drawer-detection-code', 'detection-rule.yaml')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">⬇ Download</button>
              <button onclick="copyCode('drawer-detection-code')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">📋 Copy Rule</button>
            </div>
          </div>
          <pre style="margin: 0; padding: 0.85rem; background: #0f172a; color: #a7f3d0; border-radius: 0.5rem; font-size: 0.775rem; line-height: 1.5; overflow-x: auto;"><code id="drawer-detection-code"></code></pre>
        </div>

        <!-- Tab 5: Compliance Matrix -->
        <div id="drawer-content-compliance" style="display: none;">
          <h4 style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.75rem;">Regulatory &amp; Benchmark Alignment</h4>

          <div style="margin-bottom: 0.75rem; padding: 0.75rem; background: #eff6ff; border-radius: 0.5rem; border: 1px solid #bfdbfe;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #1e40af; text-transform: uppercase; margin-bottom: 0.25rem;">CIS Kubernetes Benchmark v1.8.0</div>
            <p id="drawer-compliance-cis" style="font-size: 0.8125rem; color: #1e3a8a; margin: 0; font-weight: 500;"></p>
          </div>

          <div style="margin-bottom: 0.75rem; padding: 0.75rem; background: #f0fdf4; border-radius: 0.5rem; border: 1px solid #bbf7d0;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #166534; text-transform: uppercase; margin-bottom: 0.25rem;">NIST SP 800-190 Container Security</div>
            <p id="drawer-compliance-nist" style="font-size: 0.8125rem; color: #14532d; margin: 0; font-weight: 500;"></p>
          </div>

          <div style="padding: 0.75rem; background: #faf5ff; border-radius: 0.5rem; border: 1px solid #e9d5ff;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #6b21a8; text-transform: uppercase; margin-bottom: 0.25rem;">MITRE ATT&amp;CK for Containers</div>
            <p id="drawer-compliance-mitre" style="font-size: 0.8125rem; color: #581c87; margin: 0; font-weight: 500;"></p>
          </div>
        </div>

      </div>

      <!-- Drawer Footer -->
      <div style="padding: 0.75rem 1.25rem; border-top: 1px solid #e2e8f0; background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 0.75rem; color: #64748b;">KubeDaily Architecture Engine</span>
        <button onclick="closeInspector()" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;">Done</button>
      </div>

    </div>

  </div>

  <!-- Keyboard Shortcuts Modal Sheet -->
  <div id="shortcuts-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 100; align-items: center; justify-content: center;" onclick="if(event.target===this) toggleShortcutsModal()">
    <div style="background: var(--tm-modal-bg); border-radius: 0.75rem; width: 90%; max-width: 500px; padding: 1.5rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); border: 1px solid var(--tm-border); color: var(--tm-text-body);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--tm-text-head);">⌨️ Diagram Keyboard Shortcuts</h3>
        <button onclick="toggleShortcutsModal()" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer; color: var(--tm-text-muted);">✕</button>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.8125rem;">
        <div class="shortcut-row">
          <span>Zoom In / Out</span>
          <span class="shortcut-key">+ / −</span>
        </div>
        <div class="shortcut-row">
          <span>Reset View</span>
          <span class="shortcut-key">0</span>
        </div>
        <div class="shortcut-row">
          <span>Toggle Fullscreen</span>
          <span class="shortcut-key">f</span>
        </div>
        <div class="shortcut-row">
          <span>Search Components</span>
          <span class="shortcut-key">/</span>
        </div>
        <div class="shortcut-row">
          <span>Switch Sheets</span>
          <span class="shortcut-key">1 / 2 / 3 / 4</span>
        </div>
        <div class="shortcut-row">
          <span>Cycle Depth Level</span>
          <span class="shortcut-key">l</span>
        </div>
        <div class="shortcut-row">
          <span>Cycle Priority</span>
          <span class="shortcut-key">p</span>
        </div>
        <div class="shortcut-row">
          <span>Close Drawer / Modal</span>
          <span class="shortcut-key">Esc</span>
        </div>
      </div>

      <div style="margin-top: 1.25rem; text-align: right;">
        <button onclick="toggleShortcutsModal()" class="kube-button" style="font-size: 0.8125rem; padding: 0.4rem 0.85rem;">Got it</button>
      </div>
    </div>
  </div>

  <!-- Subtle Toast Notification -->
  <div id="kube-toast" style="display: none; position: fixed; bottom: 24px; right: 24px; background: #0f172a; color: #f8fafc; padding: 0.6rem 1.1rem; border-radius: 0.5rem; font-size: 0.8125rem; font-weight: 600; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); z-index: 1000; border: 1px solid #334155;">
    Copied to clipboard!
  </div>

  <!-- Threat Model Reference Matrix & Deep Technical Guides -->
  <div style="margin-top: 3.5rem;">
    <div class="kube-section-pill">Threat Model Reference Catalog</div>
    <h2 style="font-size: 1.75rem; font-weight: 700; margin-top: 0.5rem; color: var(--pele-fg, #0f172a);">
      Enterprise Architecture &amp; Attack Vector Catalog
    </h2>
    <p style="color: var(--pele-muted, #64748b); max-width: 900px; margin-top: 0.5rem; line-height: 1.6;">
      This model applies STRIDE (Spoofing, Tampering, Repudiation, Information Disclosure, Denial of Service, Elevation of Privilege) and the MITRE ATT&amp;CK for Containers matrix across Kubernetes components. Click any card below to automatically switch sheets, focus the diagram viewport, and inspect production YAML policies, shell audit commands, Falco eBPF detection rules, and CIS compliance benchmarks.
    </p>

    <!-- 4 Diagram Sheets Architecture Navigator -->
    <div style="margin-top: 2rem;">
      <h3 style="font-size: 1.35rem; font-weight: 700; color: var(--pele-fg, #0f172a); margin-bottom: 1rem;">
        4 Diagram Sheets Architecture Guide
      </h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">

        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #22c55e; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span class="kube-badge" style="background: #dcfce7; color: #166534; font-weight: 700;">Sheet 01</span>
              <span style="font-size: 0.75rem; color: #16a34a; font-weight: 600;">Core Topology</span>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 0.4rem 0;">Master Threat Register &amp; Cluster Overview</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              High-trust Control Plane envelope (<code class="kube-code">kube-apiserver</code>, <code class="kube-code">etcd</code>), Data Plane worker nodes (<code class="kube-code">kubelet</code>, containerd), 7 threat actors (TA01–07), and 32 threat objects (TO01–32).
            </p>
          </div>
          <button onclick="switchSheet('cluster')" class="kube-button" style="font-size: 0.75rem; padding: 0.4rem 0.75rem; margin-top: 1rem; width: 100%;">
            🖥️ Open Sheet 01 (Hotkey 1)
          </button>
        </div>

        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #ef4444; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span class="kube-badge" style="background: #fee2e2; color: #991b1b; font-weight: 700;">Sheet 02</span>
              <span style="font-size: 0.75rem; color: #dc2626; font-weight: 600;">Attack Scenarios</span>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 0.4rem 0;">Attack Chains &amp; Mitigation Narratives</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              Step-by-step kill chains spanning P1 (Ingress RCE), P2 (ServiceAccount Token Abuse), P3 (Supply Chain Injection), P4 (Host Breakout), P5 (Cloud IMDS Pivot), and P6 (Secrets Compromise).
            </p>
          </div>
          <button onclick="switchSheet('attack-chains')" class="kube-button" style="font-size: 0.75rem; padding: 0.4rem 0.75rem; margin-top: 1rem; width: 100%;">
            ⚡ Open Sheet 02 (Hotkey 2)
          </button>
        </div>

        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #3b82f6; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span class="kube-badge" style="background: #eff6ff; color: #1e40af; font-weight: 700;">Sheet 03</span>
              <span style="font-size: 0.75rem; color: #2563eb; font-weight: 600;">Defense in Depth</span>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 0.4rem 0;">Layered Security Reference Architecture</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              Defense-in-depth concentric zones: Cloud IAM &amp; OIDC boundary, isolated SLSA CI/CD builder &amp; Cosign signing, worker node isolation with Default-Deny NetworkPolicy, and Linux kernel MAC confinement.
            </p>
