        violation[{"msg": msg}] {
          c := input.review.object.spec.containers[_]
          not c.securityContext.capabilities.drop[_] == "ALL"
          msg := sprintf("Container '%v' must drop ALL capabilities (CIS 5.2.8)", [c.name])
        }
---
apiVersion: constraints.gatekeeper.sh/v1beta1
kind: K8sDropAllCapabilities
metadata:
  name: drop-all-caps
spec:
  enforcementAction: deny
  match:
    kinds:
      - apiGroups: [""]
        kinds: ["Pod"]
    excludedNamespaces: ["kube-system"]`
    },
    'generate-default-deny-netpol': {
      id: 'POL-08',
      name: 'Auto-Generate Default-Deny NetworkPolicy',
      category: 'Zero Trust Networking',
      priority: 'pri-1',
      level: 2,
      origin: 'Kubernetes CNI / Multi-Tenancy Architecture',
      motive: 'Enforce zero-trust default-deny on the flat pod network immediately upon namespace creation',
      stride: 'Information Disclosure, Denial of Service',
      overview: 'Without a NetworkPolicy, all pods can talk to all other pods across all namespaces. Kyverno automatically generates synchronized default-deny policies on namespace creation; CEL and Gatekeeper enforce mandatory zero-trust isolation labels on every tenant namespace.',
      attackVectors: ['AV09: Pod-to-pod network scanning', 'AV11: In-cluster lateral movement'],
      compliance: { cis: 'CIS Kubernetes Benchmark § 5.3.2', nist: 'NIST SP 800-190 § 4.4.1', mitre: 'T1040' },
      yaml: `apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-all
spec:
  podSelector: {}
  policyTypes: ["Ingress", "Egress"]`,
      shell: `kubectl get netpol -A`,
      detection: `hubble observe --verdict DROPPED`,
      kyverno: `# Kyverno ClusterPolicy: Auto-Generate Default-Deny NetworkPolicy
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: generate-default-deny-netpol
  annotations:
    policies.kyverno.io/title: Auto-Generate Default-Deny NetworkPolicy
    policies.kyverno.io/category: Multi-Tenancy & Zero Trust
    policies.kyverno.io/severity: high
spec:
  rules:
    - name: generate-deny-all
      match:
        any:
          - resources:
              kinds: ["Namespace"]
      generate:
        apiVersion: networking.k8s.io/v1
        kind: NetworkPolicy
        name: default-deny-all
        namespace: "{{request.object.metadata.name}}"
        synchronize: true
        data:
          spec:
            podSelector: {}
            policyTypes:
              - Ingress
              - Egress`,
      cel: `# In-Tree CEL ValidatingAdmissionPolicy (Kubernetes 1.30+ GA)
# Enforces mandatory zero-trust network tier labels on all newly provisioned namespaces
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: enforce-namespace-network-tier
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["namespaces"]
  validations:
    - expression: "has(object.metadata.labels) && has(object.metadata.labels['kubedaily.io/network-tier']) && object.metadata.labels['kubedaily.io/network-tier'] in ['isolated', 'dmz', 'restricted']"
      message: "Namespaces must declare a valid kubedaily.io/network-tier label (isolated, dmz, or restricted) for automated CNI segmentation"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: enforce-namespace-network-tier-binding
spec:
  policyName: enforce-namespace-network-tier
  validationActions: [Deny]`,
      gatekeeper: `# OPA Gatekeeper ConstraintTemplate & Constraint (Rego Engine)
apiVersion: templates.gatekeeper.sh/v1
kind: ConstraintTemplate
metadata:
  name: k8srequirenamespacetier
spec:
  crd:
    spec:
      names:
        kind: K8sRequireNamespaceTier
  targets:
    - target: admission.k8s.gatekeeper.sh
      rego: |
        package k8srequirenamespacetier
        violation[{"msg": msg}] {
          not input.review.object.metadata.labels["kubedaily.io/network-tier"]
          msg := "Namespaces must declare 'kubedaily.io/network-tier' label for zero-trust isolation"
        }
---
apiVersion: constraints.gatekeeper.sh/v1beta1
kind: K8sRequireNamespaceTier
metadata:
  name: require-ns-tier
spec:
  enforcementAction: deny
  match:
    kinds:
      - apiGroups: [""]
        kinds: ["Namespace"]
    excludedNamespaces: ["kube-system", "kube-public", "kube-node-lease"]`
    }
  };

  // Switch Active Engine in the Inspector Drawer
  function switchDrawerPolicyEngine(engine) {
    currentPolicyEngine = engine;
    ['kyverno', 'cel', 'gatekeeper'].forEach(eng => {
      const btn = document.getElementById(`drawer-engine-btn-${eng}`);
      if (btn) {
        if (eng === engine) {
          btn.classList.add('active');
          btn.style.background = '#2563eb';
          btn.style.color = '#ffffff';
        } else {
          btn.classList.remove('active');
          btn.style.background = 'transparent';
          btn.style.color = '#94a3b8';
        }
      }
    });

    const labelEl = document.getElementById('drawer-policy-engine-label');
    const docsLink = document.getElementById('drawer-policy-docs-link');
    if (engine === 'kyverno') {
      if (labelEl) labelEl.textContent = 'Kyverno ClusterPolicy (v1)';
      if (docsLink) {
        docsLink.textContent = 'kyverno.io ↗';
        docsLink.href = 'https://kyverno.io';
        docsLink.style.background = '#dbeafe';
        docsLink.style.color = '#1d4ed8';
      }
    } else if (engine === 'cel') {
      if (labelEl) labelEl.textContent = 'ValidatingAdmissionPolicy (In-Tree CEL 1.30+ GA)';
      if (docsLink) {
        docsLink.textContent = 'kubernetes.io CEL ↗';
        docsLink.href = 'https://kubernetes.io/docs/reference/access-authn-authz/validating-admission-policy/';
        docsLink.style.background = '#fef3c7';
        docsLink.style.color = '#92400e';
      }
    } else if (engine === 'gatekeeper') {
      if (labelEl) labelEl.textContent = 'OPA Gatekeeper (Rego ConstraintTemplate)';
      if (docsLink) {
        docsLink.textContent = 'open-policy-agent.org ↗';
        docsLink.href = 'https://open-policy-agent.github.io/gatekeeper/website/docs/';
        docsLink.style.background = '#ede9fe';
        docsLink.style.color = '#5b21b6';
      }
    }

    renderDrawerPolicyCode();
  }

  // Render Code Inside Drawer Based on Currently Selected Policy Engine
  function renderDrawerPolicyCode() {
    if (!currentInspectorData) return;
    const codeEl = document.getElementById('drawer-kyverno-code');
    if (!codeEl) return;

    let policyContent = '';
    if (currentPolicyEngine === 'kyverno') {
      policyContent = currentInspectorData.kyverno || generateKyvernoPolicy(currentInspectorData);
    } else if (currentPolicyEngine === 'cel') {
      policyContent = currentInspectorData.cel || generateCelPolicy(currentInspectorData);
    } else if (currentPolicyEngine === 'gatekeeper') {
      policyContent = currentInspectorData.gatekeeper || generateGatekeeperPolicy(currentInspectorData);
    }
    codeEl.textContent = policyContent;
  }

  // Download Drawer Policy File with Appropriate Engine File Extension
  function downloadDrawerPolicy() {
    let filename = 'policy.yaml';
    if (currentPolicyEngine === 'kyverno') filename = 'kyverno-policy.yaml';
    else if (currentPolicyEngine === 'cel') filename = 'validating-admission-policy-cel.yaml';
    else if (currentPolicyEngine === 'gatekeeper') filename = 'gatekeeper-rego-constraint.yaml';
    downloadCode('drawer-kyverno-code', filename);
  }

  // Set Engine for Specific Policy Library Card
  function setCardEngine(cardIdx, engine, policyKey) {
    cardEngines[cardIdx] = engine;
    ['kyverno', 'cel', 'gatekeeper'].forEach(eng => {
      const btn = document.getElementById(`card-btn-${cardIdx}-${eng}`);
      if (btn) {
        if (eng === engine) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      }
    });

    const badge = document.getElementById(`card-badge-${cardIdx}`);
    const codeEl = document.getElementById(`card-code-${cardIdx}`);
    const policyObj = libraryPolicies[policyKey];
    if (!policyObj) return;

    if (engine === 'kyverno') {
      if (badge) {
        badge.textContent = 'Kyverno · Enforce';
        badge.style.background = '#dbeafe';
        badge.style.color = '#1e40af';
      }
      if (codeEl) {
        codeEl.textContent = getSnippet(policyObj.kyverno, 6);
      }
    } else if (engine === 'cel') {
      if (badge) {
        badge.textContent = 'In-Tree CEL · 1.30+ GA';
        badge.style.background = '#fef3c7';
        badge.style.color = '#92400e';
      }
      if (codeEl) {
        codeEl.textContent = getSnippet(policyObj.cel, 6);
      }
    } else if (engine === 'gatekeeper') {
      if (badge) {
        badge.textContent = 'Gatekeeper · Rego';
        badge.style.background = '#ede9fe';
        badge.style.color = '#5b21b6';
      }
      if (codeEl) {
        codeEl.textContent = getSnippet(policyObj.gatekeeper, 6);
      }
    }
  }

  function getSnippet(fullText, maxLines) {
    if (!fullText) return '';
    return fullText.split('\n').slice(0, maxLines).join('\n') + '\n...';
  }

  function copyCardPolicy(cardIdx) {
    const codeEl = document.getElementById(`card-code-${cardIdx}`);
    if (codeEl) {
      navigator.clipboard.writeText(codeEl.textContent).then(() => {
        const origText = event.target.textContent;
        event.target.textContent = '✅';
        setTimeout(() => { event.target.textContent = origText; }, 1800);
      });
    }
  }

  function inspectCardPolicy(cardIdx, policyKey) {
    const engine = cardEngines[cardIdx] || 'kyverno';
    inspectKyvernoPolicy(policyKey);
    switchDrawerPolicyEngine(engine);
  }

  // Open inspector focusing specifically on a policy library card
  function inspectKyvernoPolicy(policyKey) {
    let comp = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.components[policyKey] : null;
    if (!comp) {
      comp = libraryPolicies[policyKey];
    }

    if (comp) {
      openInspector(comp, policyKey);
      switchDrawerTab('kyverno');
    }
  }

  // Open Slide-over Inspector Drawer with all 6 Tabs
  function openInspector(data, slugOrText) {
    const drawer = document.getElementById('inspector-drawer');
    if (!drawer) return;

    currentPin = data.id || slugOrText;
    currentInspectorData = data;

    // Populate Header & Badges
    document.getElementById('drawer-title').textContent = data.name;
    document.getElementById('drawer-id-badge').textContent = data.id || 'TO';
    document.getElementById('drawer-category-badge').textContent = data.category || 'Architecture';

    // Priority badge styling
    const priBadge = document.getElementById('drawer-priority-badge');
    if (priBadge) {
      const pri = data.priority || 'pri-2';
      priBadge.textContent = pri.toUpperCase();
      if (pri === 'pri-1') {
        priBadge.style.background = '#fee2e2';
        priBadge.style.color = '#991b1b';
      } else if (pri === 'pri-2') {
        priBadge.style.background = '#fef3c7';
        priBadge.style.color = '#92400e';
      } else if (pri === 'pri-3') {
        priBadge.style.background = '#fef9c3';
        priBadge.style.color = '#854d0e';
      } else {
        priBadge.style.background = '#cffafe';
        priBadge.style.color = '#0e7490';
      }
    }

    // Level badge
    const lvlBadge = document.getElementById('drawer-level-badge');
    if (lvlBadge) {
      lvlBadge.textContent = `Level ${data.level !== undefined ? data.level : 1}`;
    }

    // Populate Tab 1: Overview
    document.getElementById('drawer-overview-text').textContent = data.overview;
    document.getElementById('drawer-origin-text').textContent = data.origin || 'Cluster Scope';
    document.getElementById('drawer-motive-text').textContent = data.motive || 'Operational Workload';
    document.getElementById('drawer-stride-text').textContent = data.stride || 'N/A';

    // Vectors List
    const vectorsList = document.getElementById('drawer-vectors-list');
    vectorsList.innerHTML = '';
    if (data.attackVectors && data.attackVectors.length > 0) {
      document.getElementById('drawer-vectors-section').style.display = 'block';
      data.attackVectors.forEach(vec => {
        const li = document.createElement('li');
        li.textContent = vec;
        vectorsList.appendChild(li);
      });
    } else {
      document.getElementById('drawer-vectors-section').style.display = 'none';
    }

    // Populate Tab 2: YAML
    document.getElementById('drawer-yaml-code').textContent = data.yaml || '# No manifest required for this component';

    // Populate Tab 3: Policy-as-Code (Kyverno, In-Tree CEL, Gatekeeper)
    renderDrawerPolicyCode();

    // Populate Tab 4: Shell
    document.getElementById('drawer-shell-code').textContent = data.shell || '# No CLI verification command specified';

    // Populate Tab 5: Detection
    document.getElementById('drawer-detection-code').textContent = data.detection || '# No detection signature specified';

    // Populate Tab 6: Compliance
    const cisEl = document.getElementById('drawer-compliance-cis');
    const nistEl = document.getElementById('drawer-compliance-nist');
    const mitreEl = document.getElementById('drawer-compliance-mitre');
    if (data.compliance) {
      cisEl.textContent = data.compliance.cis || 'N/A';
      nistEl.textContent = data.compliance.nist || 'N/A';
      mitreEl.textContent = data.compliance.mitre || 'N/A';
    } else {
      cisEl.textContent = 'CIS Benchmark: General Cluster Hardening';
      nistEl.textContent = 'NIST SP 800-190 § 4.1';
      mitreEl.textContent = 'MITRE ATT&CK for Containers';
    }

    // Open drawer
    drawer.style.transform = 'translateX(0)';

    // Update URL query parameters for deep linking
    updateUrlParams();
  }

  function closeInspector() {
    const drawer = document.getElementById('inspector-drawer');
    if (drawer) {
      drawer.style.transform = 'translateX(100%)';
    }
    if (activeElement) {
      activeElement.classList.remove('highlight-pulse');
      activeElement = null;
    }
    currentPin = null;
    updateUrlParams();
  }

  // Switch between Inspector Tabs (6 Tabs)
  function switchDrawerTab(tabName) {
    const tabs = ['overview', 'yaml', 'kyverno', 'shell', 'detection', 'compliance'];
    tabs.forEach(t => {
      const btn = document.getElementById(`tab-btn-${t}`);
      const content = document.getElementById(`drawer-content-${t}`);
      if (btn && content) {
        if (t === tabName) {
          btn.classList.add('active');
          content.style.display = 'block';
        } else {
          btn.classList.remove('active');
          content.style.display = 'none';
        }
      }
    });
  }

  // Abstraction Depth Levels (L0 - L3)
  function setLevel(lvl) {
    currentLevel = lvl;
    for (let i = 0; i <= 3; i++) {
      const btn = document.getElementById(`level-btn-${i}`);
      if (btn) {
        if (i === lvl) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    }

    const titles = [
      'L0: Boundary',
      'L1: Standard',
      'L2: Security',
      'L3: Kernel'
    ];
    const badge = document.getElementById('level-title-badge');
    if (badge) badge.textContent = titles[lvl];

    // Filter SVG elements based on depth
    applyLevelFiltering(lvl);
    updateUrlParams();
  }

  function applyLevelFiltering(lvl) {
    const svg = document.querySelector('#diagram-svg-target svg');
    if (!svg) return;

    if (lvl === 0) {
      handleSearch('Cluster', false);
    } else if (lvl === 3) {
      handleSearch('containerd', false);
    } else {
      clearSearch();
    }
  }

  // Priority Filters (All, Pri-1, Pri-2, Pri-3, Info)
  function setPriorityFilter(pri) {
    currentPriority = pri;
    const pris = ['all', 'pri-1', 'pri-2', 'pri-3', 'info'];
    pris.forEach(p => {
      const btn = document.getElementById(`pri-btn-${p}`);
      if (btn) {
        if (p === pri) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    });

    const catalog = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.components : {};
    if (pri === 'all') {
      clearSearch();
    } else {
      const matchingIds = Object.values(catalog)
        .filter(c => c.priority === pri)
        .map(c => c.id);

      if (matchingIds.length > 0) {
        handleSearch(matchingIds[0], false);
      }
    }
    updateUrlParams();
  }

  // STRIDE Taxonomy Filter
  function setStrideFilter(letter) {
    currentStride = letter;
    const letters = ['all', 'S', 'T', 'R', 'I', 'D', 'E'];
    letters.forEach(l => {
      const btn = document.getElementById(`stride-btn-${l}`);
      if (btn) {
        if (l === letter) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    });

    const catalog = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.components : {};
    if (letter === 'all') {
      clearSearch();
    } else {
      const match = Object.values(catalog).find(c => c.stride && c.stride.includes(letter));
      if (match) {
        handleSearch(match.id, false);
      }
    }
  }

  // Traffic Flow Overlay Controller
  function setTrafficFlow(flowKey) {
    currentFlow = flowKey;
    const flows = ['off', 'ingress', 'egress', 'attack-path'];
    flows.forEach(f => {
      const btn = document.getElementById(`flow-btn-${f}`);
      if (btn) {
        if (f === flowKey) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    });

    const stepperCard = document.getElementById('flow-stepper-card');
    const catalogFlows = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.trafficFlows : {};

    if (flowKey === 'off' || !catalogFlows[flowKey]) {
      if (stepperCard) stepperCard.style.display = 'none';
      return;
    }

    const flowData = catalogFlows[flowKey];
    if (stepperCard) {
      stepperCard.style.display = 'block';
      document.getElementById('flow-stepper-title').textContent = flowData.name;
      document.getElementById('flow-stepper-desc').textContent = flowData.description;

      const stepsContainer = document.getElementById('flow-stepper-steps');
      stepsContainer.innerHTML = '';
      flowData.steps.forEach((step, idx) => {
        const stepBadge = document.createElement('div');
        stepBadge.style.cssText = `background: rgba(255,255,255,0.08); border-radius: 4px; padding: 4px 8px; white-space: nowrap; border-left: 3px solid ${flowData.color};`;
        stepBadge.innerHTML = `<strong>${step.label}</strong><br><span style="opacity: 0.8;">${step.desc}</span>`;
        stepsContainer.appendChild(stepBadge);
      });
    }

    if (flowKey === 'ingress') {
      handleSearch('ingress', false);
    } else if (flowKey === 'egress') {
      handleSearch('coredns', false);
    } else if (flowKey === 'attack-path') {
      handleSearch('P1', false);
    }
  }

  // Keyboard Shortcuts Modal Toggle
  function toggleShortcutsModal() {
    const modal = document.getElementById('shortcuts-modal-overlay');
    if (!modal) return;
    modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
  }

  // Download menu toggle
  function toggleDownloadMenu() {
    const menu = document.getElementById('download-dropdown-menu');
    if (!menu) return;
    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
  }

  document.addEventListener('click', (e) => {
    if (!e.target.closest('#download-dropdown-menu') && !e.target.textContent.includes('Export')) {
      const menu = document.getElementById('download-dropdown-menu');
      if (menu) menu.style.display = 'none';
    }
    if (!e.target.closest('#diagram-search-input') && !e.target.closest('#search-autocomplete-dropdown')) {
      const dropdown = document.getElementById('search-autocomplete-dropdown');
      if (dropdown) dropdown.style.display = 'none';
    }
  });

  // Export JSON Catalog
  function exportCatalogJson() {
    const data = window.KUBEDAILY_THREAT_MODEL_DATA;
    if (!data) return;
    const str = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(data, null, 2));
    const a = document.createElement('a');
    a.setAttribute("href", str);
    a.setAttribute("download", "kubernetes-threat-model-catalog.json");
    document.body.appendChild(a);
    a.click();
    a.remove();
    showToast('Catalog JSON downloaded!');
  }

  // Copy helpers with Toast Notification
  function copyCode(elementId) {
    const code = document.getElementById(elementId);
    if (!code) return;
    navigator.clipboard.writeText(code.textContent).then(() => {
      showToast('Copied to clipboard!');
    });
  }

  function downloadCode(elementId, filename) {
    const code = document.getElementById(elementId);
    if (!code) return;
    const blob = new Blob([code.textContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    showToast(`Downloaded ${filename}!`);
  }

  function copyDeepLink() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      showToast('Deep link copied to clipboard!');
    });
  }

  function showToast(msg) {
    const toast = document.getElementById('kube-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 2400);
  }

  // Switch between Sheet 1, Sheet 2, Sheet 3, and Sheet 4
  function switchSheet(sheetKey) {
    if (!sheetUrls[sheetKey]) return;
    currentSheet = sheetKey;
    const data = sheetUrls[sheetKey];

    const badge = document.getElementById('sheet-title-badge');
    if (badge) badge.textContent = data.title;

    const btnCluster = document.getElementById('btn-sheet-cluster');
    const btnAttacks = document.getElementById('btn-sheet-attack-chains');
    const btnSecArch = document.getElementById('btn-sheet-security-architecture');
    const btnFlows = document.getElementById('btn-sheet-flow-analysis');

    if (btnCluster) btnCluster.className = sheetKey === 'cluster' ? 'kube-button' : 'kube-button kube-button-secondary';
    if (btnAttacks) btnAttacks.className = sheetKey === 'attack-chains' ? 'kube-button' : 'kube-button kube-button-secondary';
    if (btnSecArch) btnSecArch.className = sheetKey === 'security-architecture' ? 'kube-button' : 'kube-button kube-button-secondary';
    if (btnFlows) btnFlows.className = sheetKey === 'flow-analysis' ? 'kube-button' : 'kube-button kube-button-secondary';

    const svgLink = document.getElementById('btn-download-svg');
    const pngLink = document.getElementById('btn-download-png');
    if (svgLink) {
      svgLink.href = data.svg;
      svgLink.download = `${sheetKey}.svg`;
    }
    if (pngLink) {
      pngLink.href = data.png;
      pngLink.download = `${sheetKey}.png`;
    }

    closeInspector();
    loadSvg(sheetKey);
    resetZoom();
  }

  // Apply Pre-packaged View Scenarios
  function applyPresetView(viewKey) {
    const views = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.views : {};
    const view = views[viewKey];
    if (!view) return;

    document.querySelectorAll('.view-pill-btn').forEach(btn => btn.classList.remove('active'));
    if (event && event.target) event.target.classList.add('active');

    if (view.sheet !== currentSheet) {
      switchSheet(view.sheet);
    }

    currentZoom = view.camera.zoom;
    applyZoom();

    const pane = document.getElementById('diagram-scroll-pane');
    if (pane) {
      pane.scrollLeft = Math.abs(view.camera.x);
      pane.scrollTop = Math.abs(view.camera.y);
    }

    if (view.level !== undefined) {
      setLevel(view.level);
    }

    if (view.highlight && view.highlight.length > 0) {
      handleSearch(view.highlight[0], false);
    }

    updateUrlParams(viewKey);
  }

  // Live Search & Autocomplete across SVG elements and Catalog
  function handleSearch(query, showDropdown = true) {
    const clearBtn = document.getElementById('search-clear-btn');
    const badge = document.getElementById('search-results-badge');
    const dropdown = document.getElementById('search-autocomplete-dropdown');

    if (!query || !query.trim()) {
      clearSearch();
      return;
    }

    if (clearBtn) clearBtn.style.display = 'block';
    const q = query.toLowerCase().trim();
    const svg = document.querySelector('#diagram-svg-target svg');
    const catalog = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.components : {};

    let matches = 0;
    let firstMatch = null;

    if (svg) {
      svg.querySelectorAll('g').forEach(g => {
        const text = g.textContent.toLowerCase();
        if (text.includes(q)) {
          g.classList.add('highlight-pulse');
          matches++;
          if (!firstMatch) firstMatch = g;
        } else {
          g.classList.remove('highlight-pulse');
        }
      });
    }

    if (badge) {
      badge.style.display = 'inline';
      badge.textContent = `${matches} match${matches === 1 ? '' : 'es'}`;
    }

    if (firstMatch) {
      firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
    }

    // Render autocomplete dropdown
    if (dropdown && showDropdown) {
      const results = Object.values(catalog).filter(c =>
        c.id.toLowerCase().includes(q) ||
        c.name.toLowerCase().includes(q) ||
        c.category.toLowerCase().includes(q)
      ).slice(0, 8);

      if (results.length > 0) {
        dropdown.innerHTML = '';
        results.forEach(res => {
          const item = document.createElement('div');
          item.className = 'search-autocomplete-item';
          item.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
              <span class="kube-badge" style="font-size:0.7rem; font-weight:700;">${res.id}</span>
              <span style="font-size:0.7rem; color:#64748b;">${res.category}</span>
            </div>
            <div style="font-size:0.8rem; font-weight:600; color:#0f172a;">${res.name}</div>
          `;
          item.onclick = () => {
            dropdown.style.display = 'none';
            locateAndInspect(res.id.toLowerCase(), res.id);
          };
          dropdown.appendChild(item);
        });
        dropdown.style.display = 'block';
      } else {
        dropdown.style.display = 'none';
      }
    }
  }

  function clearSearch() {
    const input = document.getElementById('diagram-search-input');
    const clearBtn = document.getElementById('search-clear-btn');
    const badge = document.getElementById('search-results-badge');
    const dropdown = document.getElementById('search-autocomplete-dropdown');

    if (input) input.value = '';
    if (clearBtn) clearBtn.style.display = 'none';
    if (badge) badge.style.display = 'none';
    if (dropdown) dropdown.style.display = 'none';

    const svg = document.querySelector('#diagram-svg-target svg');
    if (svg) {
      svg.querySelectorAll('.highlight-pulse').forEach(el => el.classList.remove('highlight-pulse'));
    }
  }

  // Zoom & Pan Engine
  function adjustZoom(delta) {
    currentZoom = Math.min(Math.max(0.4, currentZoom + delta), 2.5);
    applyZoom();
  }

  function resetZoom() {
    currentZoom = 1.0;
    applyZoom();
    const pane = document.getElementById('diagram-scroll-pane');
    if (pane) {
      pane.scrollLeft = 0;
      pane.scrollTop = 0;
    }
  }

  function applyZoom() {
    const wrapper = document.getElementById('diagram-scalable-wrapper');
    const indicator = document.getElementById('zoom-indicator');
    if (wrapper) {
      wrapper.style.transform = `scale(${currentZoom})`;
    }
    if (indicator) {
      indicator.textContent = `${Math.round(currentZoom * 100)}%`;
    }
  }

  function toggleFullscreen() {
    const container = document.getElementById('diagram-viewport-container');
    if (!document.fullscreenElement) {
      container.requestFullscreen().catch(err => {
        console.warn('Fullscreen request failed:', err);
      });
    } else {
      document.exitFullscreen();
    }
  }

  // URL Query Parameters Sync (Deep Linking)
  function updateUrlParams(viewKey) {
    const params = new URLSearchParams();
    params.set('sheet', currentSheet);
    if (viewKey) params.set('view', viewKey);
    if (currentPin) params.set('pin', currentPin);
    if (currentLevel !== 0) params.set('level', currentLevel);
    if (currentPriority !== 'all') params.set('priority', currentPriority);
    const newUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState({}, '', newUrl);
  }

  function checkUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const sheet = params.get('sheet');
    const view = params.get('view');
    const pin = params.get('pin');
    const level = params.get('level');
    const priority = params.get('priority');

    if (sheet && sheet !== currentSheet && sheetUrls[sheet]) {
      switchSheet(sheet);
      return;
    }

    if (level !== null && !isNaN(parseInt(level))) {
      setLevel(parseInt(level));
    }

    if (priority) {
      setPriorityFilter(priority);
    }

    if (view) {
      applyPresetView(view);
    }

    if (pin) {
      const catalog = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.components : {};
      if (catalog[pin.toLowerCase()]) {
        openInspector(catalog[pin.toLowerCase()], pin);
      }
    }
  }

  // Keyboard Hotkeys Navigation
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
      if (e.key === 'Escape') {
        clearSearch();
        e.target.blur();
      }
      return;
    }

    if (e.key === '?') {
      e.preventDefault();
      toggleShortcutsModal();
    } else if (e.key === '+' || e.key === '=') {
      e.preventDefault();
      adjustZoom(0.15);
    } else if (e.key === '-' || e.key === '_') {
      e.preventDefault();
      adjustZoom(-0.15);
    } else if (e.key === '0') {
      e.preventDefault();
      resetZoom();
    } else if (e.key === 'f' || e.key === 'F') {
      e.preventDefault();
      toggleFullscreen();
    } else if (e.key === '/') {
      e.preventDefault();
      const searchInput = document.getElementById('diagram-search-input');
      if (searchInput) searchInput.focus();
    } else if (e.key === '1') {
      e.preventDefault();
      switchSheet('cluster');
    } else if (e.key === '2') {
      e.preventDefault();
      switchSheet('attack-chains');
    } else if (e.key === '3') {
      e.preventDefault();
      switchSheet('security-architecture');
    } else if (e.key === '4') {
      e.preventDefault();
      switchSheet('flow-analysis');
    } else if (e.key === 'l' || e.key === 'L') {
      e.preventDefault();
      setLevel((currentLevel + 1) % 4);
    } else if (e.key === 'p' || e.key === 'P') {
      e.preventDefault();
      const priorities = ['all', 'pri-1', 'pri-2', 'pri-3', 'info'];
      const nextIdx = (priorities.indexOf(currentPriority) + 1) % priorities.length;
      setPriorityFilter(priorities[nextIdx]);
    } else if (e.key === 'Escape') {
      const modal = document.getElementById('shortcuts-modal-overlay');
      if (modal && modal.style.display === 'flex') {
        toggleShortcutsModal();
      } else {
        closeInspector();
        clearSearch();
      }
    }
  });

  // Mouse drag pan implementation
  const scrollPane = document.getElementById('diagram-scroll-pane');
  if (scrollPane) {
    scrollPane.addEventListener('mousedown', (e) => {
      if (e.target.closest('#inspector-drawer') || e.target.closest('#flow-stepper-card')) return;
      isDragging = true;
      scrollPane.style.cursor = 'grabbing';
      scrollPane.style.userSelect = 'none';
      startX = e.pageX - scrollPane.offsetLeft;
      startY = e.pageY - scrollPane.offsetTop;
      scrollLeft = scrollPane.scrollLeft;
      scrollTop = scrollPane.scrollTop;
    });

    scrollPane.addEventListener('mouseleave', () => {
      isDragging = false;
      scrollPane.style.cursor = 'grab';
    });

    scrollPane.addEventListener('mouseup', () => {
      isDragging = false;
      scrollPane.style.cursor = 'grab';
    });

    scrollPane.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - scrollPane.offsetLeft;
      const y = e.pageY - scrollPane.offsetTop;
      const walkX = (x - startX) * 1.5;
      const walkY = (y - startY) * 1.5;
      scrollPane.scrollLeft = scrollLeft - walkX;
      scrollPane.scrollTop = scrollTop - walkY;
    });

    scrollPane.addEventListener('wheel', (e) => {
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        adjustZoom(e.deltaY < 0 ? 0.1 : -0.1);
      }
    }, { passive: false });
  }

  // ============================================================================
  // Scorecard Controller (Option 2)
  // ============================================================================
  let scorecardCheckedState = {};
  let scorecardFilter = 'all';
  let scorecardRemediationEngine = 'kyverno';

  function initScorecard() {
    const rawSaved = localStorage.getItem('kubedaily_scorecard_checks');
    if (rawSaved) {
      try {
        scorecardCheckedState = JSON.parse(rawSaved) || {};
      } catch (e) {
        scorecardCheckedState = {};
      }
    } else {
      scorecardCheckedState = {};
      if (window.KUBEDAILY_SCORECARD_DATA) {
        window.KUBEDAILY_SCORECARD_DATA.forEach(chk => {
          if (chk.defaultBaseline) {
            scorecardCheckedState[chk.id] = true;
          }
        });
      }
    }

    renderScorecardItems();
    updateScorecardStats();
  }

  function renderScorecardItems() {
    const container = document.getElementById('scorecard-items-container');
    if (!container || !window.KUBEDAILY_SCORECARD_DATA) return;

    container.innerHTML = '';
    const checks = window.KUBEDAILY_SCORECARD_DATA;

    checks.forEach(chk => {
      const isChecked = !!scorecardCheckedState[chk.id];
      const isVisible = scorecardFilter === 'all' || chk.domain === scorecardFilter;

      const itemEl = document.createElement('div');
      itemEl.id = `scorecard-row-${chk.id}`;
      itemEl.className = `kube-card scorecard-item ${isChecked ? 'is-checked' : ''}`;
      itemEl.style.display = isVisible ? 'block' : 'none';
      itemEl.style.padding = '1.1rem 1.25rem';
      itemEl.style.borderRadius = '0.65rem';
      itemEl.style.borderLeft = isChecked ? '4px solid #10b981' : (chk.severity === 'critical' ? '4px solid #ef4444' : '4px solid #f59e0b');

      const sevBg = chk.severity === 'critical' ? '#fee2e2' : (chk.severity === 'high' ? '#ffedd5' : '#fef9c3');
      const sevFg = chk.severity === 'critical' ? '#991b1b' : (chk.severity === 'high' ? '#9a3412' : '#854d0e');

      itemEl.innerHTML = `
        <div style="display: flex; align-items: flex-start; gap: 1rem;">
          <div onclick="toggleScorecardCheck('${chk.id}')" class="scorecard-checkbox ${isChecked ? 'checked' : ''}" id="scorecard-box-${chk.id}" title="${isChecked ? 'Mark as Not Implemented' : 'Mark as Implemented'}">
            ${isChecked ? '✓' : ''}
          </div>

          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.35rem;">
              <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                <span class="scorecard-id-pill">${chk.id}</span>
                <span class="kube-badge" style="background: ${sevBg}; color: ${sevFg}; font-weight: 700; font-size: 0.6875rem;">${chk.severity.toUpperCase()}</span>
                <span style="font-size: 0.72rem; color: var(--tm-text-muted); font-weight: 600;">${chk.domainName}</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                <span class="scorecard-tag-pill">${chk.cis}</span>
                <span class="scorecard-tag-pill">MITRE ${chk.mitre}</span>
              </div>
            </div>

            <h4 style="font-size: 1rem; font-weight: 700; color: var(--tm-text-head); margin: 0 0 0.25rem 0; cursor: pointer;" onclick="toggleScorecardCheck('${chk.id}')">
              ${chk.title}
            </h4>
            <p style="font-size: 0.8125rem; color: var(--tm-text-muted); line-height: 1.5; margin: 0;">
              ${chk.desc}
            </p>

            <div id="scorecard-tray-${chk.id}" style="display: none; margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px dashed var(--tm-border);">
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--tm-text-head); margin-bottom: 0.3rem;">CLI Verification Command:</div>
              <pre style="margin: 0 0 0.65rem 0; padding: 0.5rem 0.75rem; background: #0f172a; color: #38bdf8; border-radius: 0.375rem; font-size: 0.75rem; overflow-x: auto;"><code>${chk.cliVerify}</code></pre>
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--tm-text-head); margin-bottom: 0.3rem;">Remediation Policy Target:</div>
              <div style="font-size: 0.75rem; color: var(--tm-text-muted);">
                Enforce policy via <strong>${scorecardRemediationEngine.toUpperCase()}</strong>:
                <code class="kube-code">${chk.policyKey}</code>
              </div>
            </div>

            <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem; flex-wrap: wrap;">
              <button onclick="toggleCheckRemediation('${chk.id}')" class="kube-button kube-button-secondary" style="font-size: 0.72rem; padding: 0.2rem 0.55rem;">
                🔍 Verify CLI
              </button>
              <button onclick="inspectScorecardCheck('${chk.componentKey}', '${chk.policyKey}')" class="kube-button kube-button-secondary" style="font-size: 0.72rem; padding: 0.2rem 0.55rem;">
                ⚡ Inspect Hardening Policy
              </button>
            </div>
          </div>
        </div>
      `;
      container.appendChild(itemEl);
    });
  }

  function toggleScorecardCheck(id) {
    scorecardCheckedState[id] = !scorecardCheckedState[id];
    localStorage.setItem('kubedaily_scorecard_checks', JSON.stringify(scorecardCheckedState));

    const row = document.getElementById(`scorecard-row-${id}`);
    const box = document.getElementById(`scorecard-box-${id}`);
    const isChecked = !!scorecardCheckedState[id];

    if (box) {
      if (isChecked) {
        box.classList.add('checked');
        box.textContent = '✓';
      } else {
        box.classList.remove('checked');
        box.textContent = '';
      }
    }

    if (row) {
      if (isChecked) {
        row.classList.add('is-checked');
        row.style.borderLeft = '4px solid #10b981';
      } else {
        row.classList.remove('is-checked');
        const chk = window.KUBEDAILY_SCORECARD_DATA.find(c => c.id === id);
        row.style.borderLeft = chk && chk.severity === 'critical' ? '4px solid #ef4444' : '4px solid #f59e0b';
      }
    }

    updateScorecardStats();
  }

  function toggleCheckRemediation(id) {
    const tray = document.getElementById(`scorecard-tray-${id}`);
    if (tray) {
      tray.style.display = tray.style.display === 'none' ? 'block' : 'none';
    }
  }

  function inspectScorecardCheck(componentKey, policyKey) {
    if (policyKey && libraryPolicies[policyKey]) {
      inspectCardPolicy(1, policyKey);
    } else if (componentKey && window.KUBEDAILY_THREAT_MODEL_DATA && window.KUBEDAILY_THREAT_MODEL_DATA.components[componentKey]) {
      openInspector(window.KUBEDAILY_THREAT_MODEL_DATA.components[componentKey], componentKey);
    } else {
      locateAndInspect('p1', 'P1');
    }
  }

  function updateScorecardStats() {
    if (!window.KUBEDAILY_SCORECARD_DATA) return;
    const checks = window.KUBEDAILY_SCORECARD_DATA;
    let totalWeight = 0;
    let earnedWeight = 0;
    let passedCount = 0;
    let criticalGaps = 0;

    checks.forEach(chk => {
      totalWeight += chk.weight;
      if (scorecardCheckedState[chk.id]) {
        earnedWeight += chk.weight;
        passedCount++;
      } else {
        if (chk.severity === 'critical') {
          criticalGaps++;
        }
      }
    });

    const percent = Math.round((earnedWeight / totalWeight) * 100);
    const scoreEl = document.getElementById('scorecard-score-percent');
    if (scoreEl) scoreEl.textContent = `${percent}%`;

    const ring = document.getElementById('scorecard-ring');
    const circumference = 226.2;
    const offset = circumference - (percent / 100) * circumference;

    let color = '#ef4444';
    let label = 'CRITICAL RISK';
    let summary = 'Severe attack vectors exposed';

    if (percent >= 100) {
      color = '#3b82f6';
      label = 'ZERO TRUST COMPLIANT';
      summary = 'All 20 enterprise controls verified & enforced';
    } else if (percent >= 85) {
      color = '#10b981';
      label = 'PRODUCTION READY';
      summary = 'Near comprehensive workload & network defense';
    } else if (percent >= 65) {
      color = '#eab308';
      label = 'HARDENED CLUSTER';
      summary = 'Strong admission guardrails, minor gaps remain';
    } else if (percent >= 35) {
      color = '#f97316';
      label = 'BASIC POSTURE';
      summary = 'Baseline controls active, missing critical defense';
    }

    if (ring) {
      ring.style.strokeDashoffset = offset;
      ring.style.stroke = color;
    }

    const labelEl = document.getElementById('scorecard-rating-label');
    if (labelEl) {
      labelEl.textContent = label;
      labelEl.style.color = color;
    }

    const summaryEl = document.getElementById('scorecard-rating-summary');
    if (summaryEl) summaryEl.textContent = summary;

    const passedEl = document.getElementById('scorecard-passed-count');
    if (passedEl) passedEl.textContent = passedCount;

    const missingEl = document.getElementById('scorecard-missing-count');
    if (missingEl) missingEl.textContent = checks.length - passedCount;

    const gapsEl = document.getElementById('scorecard-critical-gaps');
    if (gapsEl) gapsEl.textContent = criticalGaps;
  }

  function applyScorecardPreset(preset) {
    if (!window.KUBEDAILY_SCORECARD_DATA) return;
    scorecardCheckedState = {};

    window.KUBEDAILY_SCORECARD_DATA.forEach(chk => {
      if (preset === 'restricted') {
        scorecardCheckedState[chk.id] = true;
      } else if (preset === 'baseline') {
        scorecardCheckedState[chk.id] = !!chk.defaultBaseline;
      } else if (preset === 'clear') {
        scorecardCheckedState[chk.id] = false;
      }
    });

    localStorage.setItem('kubedaily_scorecard_checks', JSON.stringify(scorecardCheckedState));
    renderScorecardItems();
    updateScorecardStats();
  }

  function filterScorecardDomain(domain) {
    scorecardFilter = domain;
    ['all', 'workload', 'rbac', 'network', 'runtime', 'supply-chain'].forEach(d => {
      const btn = document.getElementById(`scorecard-filter-${d}`);
      if (btn) {
        if (d === domain) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    });

    if (window.KUBEDAILY_SCORECARD_DATA) {
      window.KUBEDAILY_SCORECARD_DATA.forEach(chk => {
        const row = document.getElementById(`scorecard-row-${chk.id}`);
        if (row) {
          row.style.display = (domain === 'all' || chk.domain === domain) ? 'block' : 'none';
        }
      });
    }
  }

  function setScorecardRemediationEngine(engine) {
    scorecardRemediationEngine = engine;
    ['kyverno', 'cel', 'gatekeeper'].forEach(eng => {
      const btn = document.getElementById(`scorecard-engine-${eng}`);
      if (btn) {
        if (eng === engine) {
          btn.classList.add('active');
          btn.style.background = '#2563eb';
          btn.style.color = '#ffffff';
        } else {
          btn.classList.remove('active');
          btn.style.background = 'transparent';
          btn.style.color = '#94a3b8';
        }
      }
    });
  }

  function exportMissingPolicyBundle() {
    if (!window.KUBEDAILY_SCORECARD_DATA) return;
    const checks = window.KUBEDAILY_SCORECARD_DATA;
    const missingChecks = checks.filter(c => !scorecardCheckedState[c.id]);

    if (missingChecks.length === 0) {
      alert('Congratulations! All 20 hardening controls are already implemented (100% Zero-Trust Posture). No missing remediation policies required!');
      return;
    }

    const engine = scorecardRemediationEngine || 'kyverno';
    let output = `# ==============================================================================
# KubeDaily Automated Remediation Policy Bundle
# Generated on: ${new Date().toISOString()}
# Target Engine: ${engine.toUpperCase()}
# Remediating: ${missingChecks.length} Missing Security Gaps
# ==============================================================================
`;

    missingChecks.forEach(chk => {
      output += `\n# --- [${chk.id}] ${chk.title} (${chk.severity.toUpperCase()}) ---
# Domain: ${chk.domainName} | CIS: ${chk.cis} | MITRE: ${chk.mitre}
`;
      const pol = libraryPolicies[chk.policyKey];
      if (pol && pol[engine]) {
        output += pol[engine] + "\n---\n";
      } else {
        const comp = window.KUBEDAILY_THREAT_MODEL_DATA ? window.KUBEDAILY_THREAT_MODEL_DATA.components[chk.componentKey] : null;
        if (comp && comp[engine]) {
          output += comp[engine] + "\n---\n";
        } else {
          output += `# Standalone policy manifest for ${chk.title}\n` + (engine === 'cel' ? generateCelPolicy(chk) : generateKyvernoPolicy(chk)) + "\n---\n";
        }
      }
    });

    const blob = new Blob([output], { type: 'text/yaml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `kubedaily-remediation-bundle-${engine}.yaml`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function exportAuditReportMarkdown() {
    if (!window.KUBEDAILY_SCORECARD_DATA) return;
    const checks = window.KUBEDAILY_SCORECARD_DATA;
    let earnedWeight = 0;
    let totalWeight = 0;
    let passedCount = 0;

    checks.forEach(chk => {
      totalWeight += chk.weight;
      if (scorecardCheckedState[chk.id]) {
        earnedWeight += chk.weight;
        passedCount++;
      }
    });

    const percent = Math.round((earnedWeight / totalWeight) * 100);
    const ratingLabel = document.getElementById('scorecard-rating-label')?.textContent || 'AUDIT';

    let md = `# Kubernetes Cluster Hardening & Posture Audit Report
**Organization / Cluster:** Production Kubernetes Infrastructure
**Generated Date:** ${new Date().toUTCString()}
**KubeDaily Posture Score:** **${percent}%** (${ratingLabel})
**Implemented Controls:** ${passedCount} / ${checks.length}
**Remediation Policy Standard:** ${scorecardRemediationEngine.toUpperCase()}

---

## Executive Summary
This audit report evaluates the cluster against 20 critical security controls across Workload Isolation, Identity & RBAC, Network Multi-Tenancy, Linux Kernel Runtime Defense, and Supply Chain Integrity.

- **Current Score:** ${percent} / 100
- **Total Passing Controls:** ${passedCount}
- **Total Identified Gaps:** ${checks.length - passedCount}
- **Regulatory Framework Alignment:** CIS Kubernetes Benchmark v1.8, NIST SP 800-190, MITRE ATT&CK for Containers

---

## Detailed Control Verification Matrix

| ID | Status | Severity | Control Title | Domain | Benchmark | MITRE |
|:---|:------:|:--------:|:--------------|:-------|:----------|:------|
`;

    checks.forEach(chk => {
      const isPassed = !!scorecardCheckedState[chk.id];
      const statusIcon = isPassed ? "PASSED" : "FAILED";
      md += `| ${chk.id} | ${statusIcon} | ${chk.severity.toUpperCase()} | ${chk.title} | ${chk.domainName} | ${chk.cis} | ${chk.mitre} |\n`;
    });

    md += `\n---

## Immediate Remediation Recommendations
`;

    const failing = checks.filter(c => !scorecardCheckedState[c.id]);
    if (failing.length === 0) {
      md += `No gaps identified. All 20 controls meet the Zero-Trust Restricted Standard.\n`;
    } else {
      failing.forEach((chk, idx) => {
        md += `\n### ${idx + 1}. [${chk.id}] ${chk.title} (${chk.severity.toUpperCase()})
- **Domain:** ${chk.domainName}
- **Impact:** ${chk.desc}
- **Verification Command:**
  \`\`\`bash
  ${chk.cliVerify}
  \`\`\`
- **Remediation Action:** Apply policy \`${chk.policyKey}\` using KubeDaily Remediation Bundle.
`;
      });
    }

    md += `\n---
*Generated by KubeDaily Threat Model & Security Architecture Engine (https://kubernetesdaily.com/threat-model)*
`;

    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `kubernetes-hardening-audit-report.md`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ============================================================================
  // MITRE ATT&CK for Containers Matrix Controller (Option 3)
  // ============================================================================
  let currentMitreTactic = 'all';

  function initMitreMatrix() {
    renderMitreMatrix();
  }

  function renderMitreMatrix() {
    const container = document.getElementById('mitre-matrix-container');
    if (!container || !window.KUBEDAILY_MITRE_MATRIX) return;

    container.innerHTML = '';
    const tactics = window.KUBEDAILY_MITRE_MATRIX;
    const query = (document.getElementById('mitre-search-input')?.value || '').trim().toLowerCase();

    tactics.forEach(tac => {
      const matchingTechs = tac.techniques.filter(tech => {
        if (!query) return true;
        return tech.id.toLowerCase().includes(query) ||
               tech.name.toLowerCase().includes(query) ||
               tech.desc.toLowerCase().includes(query) ||
               tech.mitigation.toLowerCase().includes(query);
      });

      const isTacticVisible = (currentMitreTactic === 'all' || currentMitreTactic === tac.tacticId) && matchingTechs.length > 0;

      const colEl = document.createElement('div');
      colEl.id = `mitre-col-${tac.tacticId}`;
      colEl.className = 'mitre-tactic-col';
      colEl.style.display = isTacticVisible ? 'flex' : 'none';

      let cardsHtml = '';
      matchingTechs.forEach(tech => {
        const borderTopColor = tech.severity === 'critical' ? '#ef4444' : (tech.severity === 'high' ? '#f97316' : '#eab308');
        const badgeBg = tech.severity === 'critical' ? 'rgba(239, 68, 68, 0.2)' : (tech.severity === 'high' ? 'rgba(249, 115, 22, 0.2)' : 'rgba(234, 179, 8, 0.2)');
        const badgeFg = tech.severity === 'critical' ? '#f87171' : (tech.severity === 'high' ? '#fb923c' : '#facc15');

        cardsHtml += `
          <div class="mitre-tech-card" style="border-top: 3px solid ${borderTopColor};">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
              <span style="font-size: 0.72rem; font-weight: 800; color: #38bdf8; font-family: monospace;">${tech.id}</span>
              <span class="kube-badge" style="background: ${badgeBg}; color: ${badgeFg}; font-size: 0.65rem; font-weight: 700;">${tech.severity.toUpperCase()}</span>
            </div>
            <div style="font-size: 0.825rem; font-weight: 700; color: #ffffff; line-height: 1.35; margin-bottom: 0.35rem;">
              ${tech.name}
            </div>
            <p style="font-size: 0.725rem; color: #94a3b8; line-height: 1.45; margin: 0 0 0.5rem 0;">
              ${tech.desc}
            </p>
            <div style="font-size: 0.6875rem; color: #64748b; margin-bottom: 0.6rem; line-height: 1.35;">
              <strong style="color: #cbd5e1;">Mitigation:</strong> ${tech.mitigation}
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem;">
              <button onclick="locateAndInspect('${tech.componentKey}', '${tech.componentKey.toUpperCase()}', '${tech.sheet}')" class="kube-button" style="font-size: 0.6875rem; padding: 0.2rem 0.35rem; background: #2563eb; border-color: #2563eb;">
                🎯 Diagram
              </button>
              <button onclick="locateAndInspect('${tech.componentKey}', '${tech.componentKey.toUpperCase()}')" class="kube-button kube-button-secondary" style="font-size: 0.6875rem; padding: 0.2rem 0.35rem; background: #334155; color: #f8fafc; border-color: #475569;">
                ⚡ Inspect
              </button>
            </div>
          </div>
        `;
      });

      colEl.innerHTML = `
        <div style="padding-bottom: 0.5rem; border-bottom: 1px solid #1e293b;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.7rem; font-weight: 800; color: #db2777; text-transform: uppercase; letter-spacing: 0.05em;">${tac.tacticId}</span>
            <span style="font-size: 0.6875rem; color: #64748b; font-weight: 600;">${matchingTechs.length} tech</span>
          </div>
          <div style="font-size: 0.875rem; font-weight: 700; color: #ffffff; margin-top: 0.15rem;">
            ${tac.tacticName}
          </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.65rem; overflow-y: auto; max-height: 600px; padding-right: 2px;">
          ${cardsHtml}
        </div>
      `;

      container.appendChild(colEl);
    });
  }

  function filterMitreTactic(tacticId) {
    currentMitreTactic = tacticId;
    const allPillIds = ['all', 'TA0001', 'TA0002', 'TA0003', 'TA0004', 'TA0005', 'TA0006', 'TA0007', 'TA0008', 'TA0009', 'TA0010'];
    allPillIds.forEach(id => {
      const btn = document.getElementById(`mitre-pill-${id}`);
      if (btn) {
        if (id === tacticId) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    });
    renderMitreMatrix();
  }

  function searchMitreMatrix() {
    renderMitreMatrix();
  }

  function exportMitreNavigatorLayer() {
    if (!window.KUBEDAILY_MITRE_MATRIX) return;
    const tactics = window.KUBEDAILY_MITRE_MATRIX;
    const techniquesList = [];

    tactics.forEach(tac => {
      tac.techniques.forEach(tech => {
        let score = 5;
        let color = '#ef4444';
        if (tech.severity === 'high') {
          score = 3;
          color = '#f97316';
        } else if (tech.severity === 'medium') {
          score = 1;
          color = '#eab308';
        }

        techniquesList.push({
          techniqueID: tech.id.split('.')[0],
          tactic: tac.tacticName.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
          score: score,
          color: color,
          comment: `[${tech.name}] Mitigated by KubeDaily Component: ${tech.componentKey.toUpperCase()} - ${tech.mitigation}`,
          enabled: true
        });
      });
    });

    const navigatorLayer = {
      name: "KubeDaily Kubernetes Container Threat Matrix",
      versions: {
        attack: "14",
        navigator: "4.8.1",
        layer: "4.5"
      },
      domain: "enterprise-attack",
      description: "Official KubeDaily Kubernetes Threat Model & Security Architecture MITRE ATT&CK for Containers Coverage Layer",
      filters: {
        platforms: ["Containers", "Linux"]
      },
      sorting: 3,
      layout: {
        layout: "side",
        aggregateFunction: "average",
        showID: true,
        showName: true,
        showTacticRowBackground: true
      },
      gradient: {
        colors: ["#ffffff", "#eab308", "#f97316", "#ef4444"],
        minValue: 0,
        maxValue: 5
      },
      legendItems: [
        { label: "Critical Severity (Host Escape)", color: "#ef4444" },
        { label: "High Severity (Credential Theft)", color: "#f97316" },
        { label: "Medium Severity (Discovery / Recon)", color: "#eab308" }
      ],
      techniques: techniquesList
    };

    const blob = new Blob([JSON.stringify(navigatorLayer, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `kubedaily-mitre-containers-navigator-layer.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ============================================================================
  // Red/Blue Team Attack Playbooks Controller (Option 4)
  // ============================================================================
  let currentPlaybookIdx = 0;
  let currentPlaybookMode = 'red';

  function initPlaybooks() {
    renderActivePlaybook();
  }

  function switchPlaybook(idx) {
    currentPlaybookIdx = idx;
    for (let i = 0; i < 6; i++) {
      const btn = document.getElementById(`playbook-tab-${i}`);
      if (btn) {
        if (i === idx) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    }
    renderActivePlaybook();
  }

  function switchPlaybookMode(mode) {
    currentPlaybookMode = mode;
    const redBtn = document.getElementById('playbook-mode-red');
    const blueBtn = document.getElementById('playbook-mode-blue');
    if (redBtn && blueBtn) {
      if (mode === 'red') {
        redBtn.classList.add('active');
        blueBtn.classList.remove('active');
      } else {
        blueBtn.classList.add('active');
        redBtn.classList.remove('active');
      }
    }

    const modeTag = document.getElementById('playbook-mode-tag');
    if (modeTag) {
      modeTag.textContent = mode === 'red'
        ? 'Simulating adversary attack steps against running cluster'
        : 'Verifying admission guardrails, runtime telemetry & audit logs';
    }

    renderActivePlaybook();
  }

  function renderActivePlaybook() {
    if (!window.KUBEDAILY_ATTACK_PLAYBOOKS) return;
    const pb = window.KUBEDAILY_ATTACK_PLAYBOOKS[currentPlaybookIdx];
    if (!pb) return;

    const idBadge = document.getElementById('playbook-id-badge');
    if (idBadge) idBadge.textContent = pb.id;

    const diffBadge = document.getElementById('playbook-difficulty-badge');
    if (diffBadge) diffBadge.textContent = pb.difficulty.toUpperCase();

    const vectorBadge = document.getElementById('playbook-vector-badge');
    if (vectorBadge) vectorBadge.textContent = pb.attackVector;

    const titleEl = document.getElementById('playbook-title');
    if (titleEl) titleEl.textContent = pb.title;

    const content = currentPlaybookMode === 'red' ? pb.redTeam : pb.blueTeam;

    const objBox = document.getElementById('playbook-objective-box');
    const objText = document.getElementById('playbook-objective-text');
    if (objBox && objText) {
      if (currentPlaybookMode === 'red') {
        objBox.style.background = 'rgba(239, 68, 68, 0.1)';
        objBox.style.borderLeftColor = '#ef4444';
        objText.style.color = '#fecaca';
      } else {
        objBox.style.background = 'rgba(37, 99, 235, 0.1)';
        objBox.style.borderLeftColor = '#2563eb';
        objText.style.color = '#bfdbfe';
      }
      objText.textContent = content.objective;
    }

    const terminalTitle = document.getElementById('playbook-terminal-title');
    if (terminalTitle) {
      terminalTitle.textContent = `${pb.id.toLowerCase()}-${currentPlaybookMode}team.sh`;
    }

    const scriptCode = document.getElementById('playbook-script-code');
    if (scriptCode) {
      scriptCode.textContent = content.script;
    }
  }

  function traceActivePlaybook() {
    if (!window.KUBEDAILY_ATTACK_PLAYBOOKS) return;
    const pb = window.KUBEDAILY_ATTACK_PLAYBOOKS[currentPlaybookIdx];
    if (!pb) return;
    locateAndInspect(pb.scenarioKey, pb.scenarioKey.toUpperCase(), pb.sheet);
  }

  function inspectActivePlaybook() {
    if (!window.KUBEDAILY_ATTACK_PLAYBOOKS) return;
    const pb = window.KUBEDAILY_ATTACK_PLAYBOOKS[currentPlaybookIdx];
    if (!pb) return;
    locateAndInspect(pb.scenarioKey, pb.scenarioKey.toUpperCase());
  }

  function copyPlaybookScript() {
    const codeEl = document.getElementById('playbook-script-code');
    if (codeEl) {
      navigator.clipboard.writeText(codeEl.textContent).then(() => {
        const orig = event.target.textContent;
        event.target.textContent = '✅ Copied!';
        setTimeout(() => { event.target.textContent = orig; }, 1800);
      });
    }
  }

  function downloadPlaybookScript() {
    if (!window.KUBEDAILY_ATTACK_PLAYBOOKS) return;
    const pb = window.KUBEDAILY_ATTACK_PLAYBOOKS[currentPlaybookIdx];
    if (!pb) return;
    const content = currentPlaybookMode === 'red' ? pb.redTeam : pb.blueTeam;

    const blob = new Blob([content.script], { type: 'text/x-sh' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${pb.id.toLowerCase()}-${currentPlaybookMode}team.sh`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ============================================================================
  // 1-Click Production Security Bundles Controller (Option 5)
  // ============================================================================
  function downloadSecurityBundle(bundleId) {
    if (!window.KUBEDAILY_SECURITY_BUNDLES) return;
    const bundle = window.KUBEDAILY_SECURITY_BUNDLES.find(b => b.id === bundleId);
    if (!bundle) return;

    const blob = new Blob([bundle.manifest], { type: 'text/yaml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = bundle.filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function copySecurityBundle(bundleId) {
    if (!window.KUBEDAILY_SECURITY_BUNDLES) return;
    const bundle = window.KUBEDAILY_SECURITY_BUNDLES.find(b => b.id === bundleId);
    if (!bundle) return;

    navigator.clipboard.writeText(bundle.manifest).then(() => {
      const orig = event.target.textContent;
      event.target.textContent = '✅';
      setTimeout(() => { event.target.textContent = orig; }, 1800);
    });
  }

  function inspectBundleComponents(bundleId) {
    if (!window.KUBEDAILY_SECURITY_BUNDLES) return;
    const bundle = window.KUBEDAILY_SECURITY_BUNDLES.find(b => b.id === bundleId);
    if (!bundle || !bundle.components || bundle.components.length === 0) return;
    const compKey = bundle.components[0];
    locateAndInspect(compKey, compKey.toUpperCase());
  }

  function downloadAllSecurityBundles() {
    if (!window.KUBEDAILY_SECURITY_BUNDLES) return;
    let fullArchive = `# ==============================================================================
# KubeDaily Complete Enterprise Security Bundle Suite
# Generated: ${new Date().toISOString()}
# Contains all 5 Production Bundles: Kyverno, In-Tree CEL, NetworkPolicies, Falco, CIS
# ==============================================================================
`;

    window.KUBEDAILY_SECURITY_BUNDLES.forEach(bundle => {
      fullArchive += `\n# ##############################################################################
# BUNDLE: ${bundle.title} (${bundle.filename})
# Category: ${bundle.category}
# ##############################################################################\n\n`;
      fullArchive += bundle.manifest + "\n---\n";
    });

    const blob = new Blob([fullArchive], { type: 'text/yaml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `kubedaily-complete-production-security-suite.yaml`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ============================================================================
  // Incident Response & Containment Runbooks Controller (Option 6)
  // ============================================================================
  let currentRunbookIdx = 0;

  function initIncidentRunbooks() {
    renderActiveRunbook();
  }

  function switchRunbook(idx) {
    currentRunbookIdx = idx;
    for (let i = 0; i < 6; i++) {
      const btn = document.getElementById(`runbook-tab-${i}`);
      if (btn) {
        if (i === idx) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    }
    renderActiveRunbook();
  }

  function renderActiveRunbook() {
    const container = document.getElementById('runbook-card-container');
    if (!container || !window.KUBEDAILY_INCIDENT_RUNBOOKS) return;

    const rb = window.KUBEDAILY_INCIDENT_RUNBOOKS[currentRunbookIdx];
    if (!rb) return;

    let stepsHtml = '';
    rb.steps.forEach((st, idx) => {
      stepsHtml += `
        <div style="margin-bottom: 1rem; background: #0b132b; border: 1px solid #1e293b; border-radius: 0.5rem; overflow: hidden;">
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.85rem; background: rgba(255,255,255,0.03); border-bottom: 1px solid #1e293b;">
            <span style="font-size: 0.775rem; font-weight: 700; color: #38bdf8;">${st.title}</span>
            <button onclick="copyRunbookStepText(${idx})" class="kube-button kube-button-secondary" style="font-size: 0.7rem; padding: 0.15rem 0.5rem; background: #1e293b; color: #94a3b8; border-color: #334155;">
              📋 Copy Command
            </button>
          </div>
          <pre style="margin: 0; padding: 0.85rem 1rem; color: #f8fafc; font-size: 0.775rem; line-height: 1.5; overflow-x: auto; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;"><code id="runbook-step-code-${idx}">${st.cmd}</code></pre>
        </div>
      `;
    });

    container.innerHTML = `
      <div class="kube-card" style="padding: 1.5rem; border-radius: 0.75rem; background: #0f172a; color: #f8fafc; border: 1px solid #334155;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid #1e293b;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
              <span style="font-size: 0.75rem; font-weight: 800; color: #ef4444; background: rgba(239,68,68,0.15); padding: 0.15rem 0.45rem; border-radius: 0.25rem;">${rb.id}</span>
              <span class="kube-badge" style="background: rgba(239,68,68,0.2); color: #f87171; font-size: 0.7rem; font-weight: 700;">${rb.phase.toUpperCase()}</span>
              <span class="kube-badge" style="background: rgba(249,115,22,0.2); color: #fb923c; font-size: 0.7rem; font-weight: 700;">${rb.severity.toUpperCase()}</span>
              <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 600;">Scenario: ${rb.threatScenario}</span>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">
              ${rb.title}
            </h3>
          </div>

          <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
            <button onclick="locateAndInspect('${rb.componentKey}', '${rb.componentKey.toUpperCase()}', '${rb.sheet}')" class="kube-button" style="font-size: 0.75rem; padding: 0.35rem 0.65rem; background: #2563eb; border-color: #2563eb;">
              🎯 Trace Blast Radius in Diagram
            </button>
            <button onclick="locateAndInspect('${rb.componentKey}', '${rb.componentKey.toUpperCase()}')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.65rem; background: #334155; color: #f8fafc; border-color: #475569;">
              ⚡ Hardening Specs
            </button>
          </div>
        </div>

        <div style="padding: 0.85rem 1rem; border-radius: 0.5rem; background: rgba(239, 68, 68, 0.1); border-left: 4px solid #ef4444; margin-bottom: 1.25rem;">
          <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: #f87171; font-weight: 700;">Emergency Objective:</div>
          <div style="font-size: 0.825rem; color: #fecaca; margin-top: 0.2rem; line-height: 1.5;">
            ${rb.objective}
          </div>
        </div>

        <div>
          ${stepsHtml}
        </div>
      </div>
    `;
  }

  function copyRunbookStepText(stepIdx) {
    const codeEl = document.getElementById(`runbook-step-code-${stepIdx}`);
    if (codeEl) {
      navigator.clipboard.writeText(codeEl.textContent).then(() => {
        const orig = event.target.textContent;
        event.target.textContent = '✅ Copied!';
        setTimeout(() => { event.target.textContent = orig; }, 1800);
      });
    }
  }

  function copyAllRunbookSteps() {
    if (!window.KUBEDAILY_INCIDENT_RUNBOOKS) return;
    const rb = window.KUBEDAILY_INCIDENT_RUNBOOKS[currentRunbookIdx];
    if (!rb) return;

    let fullScript = `#!/usr/bin/env bash
# ==============================================================================
# KubeDaily Emergency Incident Runbook: [${rb.id}] ${rb.title}
# Threat Scenario: ${rb.threatScenario}
# Generated: ${new Date().toISOString()}
# ==============================================================================
# Objective: ${rb.objective}

set -euo pipefail

`;
    rb.steps.forEach((st, idx) => {
      fullScript += `# --- ${st.title} ---\n${st.cmd}\n\n`;
    });

    navigator.clipboard.writeText(fullScript).then(() => {
      const orig = event.target.textContent;
      event.target.textContent = '✅ All Steps Copied!';
      setTimeout(() => { event.target.textContent = orig; }, 1800);
    });
  }

  function downloadRunbookScript() {
    if (!window.KUBEDAILY_INCIDENT_RUNBOOKS) return;
    const rb = window.KUBEDAILY_INCIDENT_RUNBOOKS[currentRunbookIdx];
    if (!rb) return;

    let fullScript = `#!/usr/bin/env bash
# ==============================================================================
# KubeDaily Emergency Incident Runbook: [${rb.id}] ${rb.title}
# Threat Scenario: ${rb.threatScenario}
# Generated: ${new Date().toISOString()}
# ==============================================================================
# Objective: ${rb.objective}

set -euo pipefail

`;
    rb.steps.forEach((st, idx) => {
      fullScript += `# --- ${st.title} ---\n${st.cmd}\n\n`;
    });

    const blob = new Blob([fullScript], { type: 'text/x-sh' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${rb.id.toLowerCase()}-containment-runbook.sh`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    loadSvg('cluster');
    initScorecard();
    initMitreMatrix();
    initPlaybooks();
    initIncidentRunbooks();
  });
</script>
