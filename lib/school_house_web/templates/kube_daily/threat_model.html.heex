      stride: 'Information Disclosure, Elevation of Privilege',
      overview: 'By default, Kubernetes mounts a JWT token at /var/run/secrets/kubernetes.io/serviceaccount/token in every pod. If the pod is compromised, an attacker can query the Kubernetes API. This policy enforces automountServiceAccountToken: false across all 3 engines.',
      attackVectors: ['AV02: Stolen ServiceAccount bearer token', 'AV07: In-cluster API enumeration'],
      compliance: { cis: 'CIS Kubernetes Benchmark § 5.1.5', nist: 'NIST SP 800-190 § 4.3', mitre: 'T1552.007' },
      yaml: `apiVersion: v1
kind: Pod
metadata:
