              <button id="card-btn-3-gatekeeper" onclick="setCardEngine(3, 'gatekeeper', 'verify-image-signatures')" class="card-engine-btn" style="flex: 1;">🛡️ Gatekeeper</button>
            </div>

            <!-- Code Preview Snippet -->
            <pre style="margin: 0.5rem 0 0 0; padding: 0.6rem; background: #0b132b; color: #38bdf8; border-radius: 0.375rem; font-size: 0.72rem; line-height: 1.45; overflow-x: auto; border: 1px solid #1e293b;"><code id="card-code-3">verifyImages:
  - imageReferences: ["ghcr.io/myorg/*"]
    attestors:
      - entries:
