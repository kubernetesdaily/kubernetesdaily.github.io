    'verify-image-signatures': {
      id: 'POL-03',
      name: 'Verify Cryptographic Signatures (Cosign)',
      category: 'Supply Chain Security',
      priority: 'pri-1',
      level: 2,
      origin: 'Container Image Registry / CI/CD Pipeline',
      motive: 'Block untrusted, unverified, or tampered container images from deploying to production',
      stride: 'Tampering, Spoofing',
      overview: 'Intercepts Pod creation to verify cryptographic provenance. Kyverno performs native Cosign signature/attestation checks, CEL validates immutable digest pinning and authorized enterprise registry domains at zero latency, and Gatekeeper enforces registry prefix whitelists.',
      attackVectors: ['AV15: Compromised container registry', 'AV16: Dependency confusion'],
      compliance: { cis: 'CIS Kubernetes Benchmark § 5.4.1', nist: 'NIST SP 800-190 § 3.1', mitre: 'T1195.002' },
      yaml: `# Cosign verification manifest
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: verify-image-signatures`,
      shell: `cosign verify --key cosign.pub ghcr.io/myorg/payment-service:v1.4.0`,
      detection: `admission webhook failure: signature verification failed for image`,
      kyverno: `# Kyverno ClusterPolicy: Verify Cosign Signatures & Attestations
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: verify-image-signatures
  annotations:
    policies.kyverno.io/title: Verify Cosign Signatures and SLSA Provenance
    policies.kyverno.io/category: Supply Chain Security
    policies.kyverno.io/severity: critical
spec:
  validationFailureAction: Enforce
  webhookTimeoutSeconds: 30
  rules:
    - name: verify-signature-rule
      match:
        any:
          - resources:
              kinds: ["Pod"]
      verifyImages:
        - imageReferences: ["ghcr.io/myorg/*", "registry.k8s.io/*"]
          attestors:
            - entries:
                - keys:
                    publicKeys: |-
                      -----BEGIN PUBLIC KEY-----
                      MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...
                      -----END PUBLIC KEY-----`,
      cel: `# In-Tree CEL ValidatingAdmissionPolicy (Kubernetes 1.30+ GA)
# CEL enforces trusted registry domain roots & immutable SHA256 digests
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: verify-image-registries
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["pods"]
  validations:
    - expression: "object.spec.containers.all(c, c.image.startsWith('ghcr.io/myorg/') || c.image.startsWith('registry.k8s.io/'))"
      message: "Container image must originate from approved registry (ghcr.io/myorg/ or registry.k8s.io/)"
    - expression: "object.spec.containers.all(c, c.image.contains('@sha256:') || !c.image.endsWith(':latest'))"
      message: "Mutable :latest tag is forbidden; pin image by immutable sha256 digest"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: verify-image-registries-binding
spec:
  policyName: verify-image-registries
  validationActions: [Deny]`,
      gatekeeper: `# OPA Gatekeeper ConstraintTemplate & Constraint (Rego Engine)
apiVersion: templates.gatekeeper.sh/v1
kind: ConstraintTemplate
metadata:
  name: k8sallowedrepos
spec:
  crd:
    spec:
      names:
        kind: K8sAllowedRepos
  targets:
    - target: admission.k8s.gatekeeper.sh
      rego: |
        package k8sallowedrepos
        violation[{"msg": msg}] {
          c := input.review.object.spec.containers[_]
          not startswith(c.image, "ghcr.io/myorg/")
          not startswith(c.image, "registry.k8s.io/")
          msg := sprintf("Container '%v' uses unapproved registry '%v'", [c.name, c.image])
        }
---
