            </div>

            <!-- Code Preview Snippet -->
            <pre style="margin: 0.5rem 0 0 0; padding: 0.6rem; background: #0b132b; color: #38bdf8; border-radius: 0.375rem; font-size: 0.72rem; line-height: 1.45; overflow-x: auto; border: 1px solid #1e293b;"><code id="card-code-6">pattern:
  spec:
    securityContext:
      runAsNonRoot: true</code></pre>

            <div style="margin-top: 0.65rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
