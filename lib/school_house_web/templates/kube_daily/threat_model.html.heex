        </div>

        <!-- Policy Card 5 -->
        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #06b6d4; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span id="card-badge-5" class="kube-badge" style="background: #dbeafe; color: #1e40af; font-weight: 700;">Kyverno · Generate</span>
              <span class="kube-badge" style="background: #fee2e2; color: #991b1b; font-weight: 600; font-size: 0.7rem;">CRITICAL</span>
            </div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.35rem 0;">Block Cloud Metadata (IMDS)</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              Automatically generates an egress NetworkPolicy denying link-local address <code class="kube-code">169.254.169.254/32</code> upon Namespace creation, blocking AWS/GCP/Azure instance role theft (P5 / AV10).
            </p>

            <!-- Engine Switcher -->
            <div style="display: flex; gap: 0.25rem; margin: 0.75rem 0 0.5rem 0; background: #f1f5f9; padding: 0.2rem; border-radius: 0.375rem;">
              <button id="card-btn-5-kyverno" onclick="setCardEngine(5, 'kyverno', 'block-cloud-metadata-imds')" class="card-engine-btn active" style="flex: 1;">⚡ Kyverno</button>
              <button id="card-btn-5-cel" onclick="setCardEngine(5, 'cel', 'block-cloud-metadata-imds')" class="card-engine-btn" style="flex: 1;">⚙️ CEL</button>
              <button id="card-btn-5-gatekeeper" onclick="setCardEngine(5, 'gatekeeper', 'block-cloud-metadata-imds')" class="card-engine-btn" style="flex: 1;">🛡️ Gatekeeper</button>
            </div>

            <!-- Code Preview Snippet -->
            <pre style="margin: 0.5rem 0 0 0; padding: 0.6rem; background: #0b132b; color: #38bdf8; border-radius: 0.375rem; font-size: 0.72rem; line-height: 1.45; overflow-x: auto; border: 1px solid #1e293b;"><code id="card-code-5">generate:
  apiVersion: networking.k8s.io/v1
  kind: NetworkPolicy
  data:
    spec:
      policyTypes: ["Egress"]</code></pre>

            <div style="margin-top: 0.65rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
              <span style="font-size: 0.7rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-weight: 600;">CIS § 5.2.2</span>
              <span style="font-size: 0.7rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-weight: 600;">MITRE T1552.005</span>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; margin-top: 0.9rem;">
            <button onclick="inspectCardPolicy(5, 'block-cloud-metadata-imds')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.65rem; width: 100%;">
