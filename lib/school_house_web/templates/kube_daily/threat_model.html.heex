        </div>

        <!-- Policy Card 4 -->
        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #8b5cf6; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span id="card-badge-4" class="kube-badge" style="background: #dbeafe; color: #1e40af; font-weight: 700;">Kyverno · Enforce</span>
              <span class="kube-badge" style="background: #fee2e2; color: #991b1b; font-weight: 600; font-size: 0.7rem;">CRITICAL</span>
            </div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.35rem 0;">Restrict ServiceAccount Automount</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              Enforces <code class="kube-code">automountServiceAccountToken: false</code> on pods. Prevents adversaries from exfiltrating projected JWT bearer tokens to execute control plane API discovery (P2 / AV02).
            </p>

            <!-- Engine Switcher -->
            <div style="display: flex; gap: 0.25rem; margin: 0.75rem 0 0.5rem 0; background: #f1f5f9; padding: 0.2rem; border-radius: 0.375rem;">
