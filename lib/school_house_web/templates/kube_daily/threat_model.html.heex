          <button onclick="locateAndInspect('ta05', 'TA05', 'cluster')" class="kube-button kube-button-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.65rem; margin-top: 0.85rem; width: 100%;">
            🔍 Inspect in Sheet 1
          </button>
