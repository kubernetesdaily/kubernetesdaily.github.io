        </div>

        <!-- Policy Card 6 -->
        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #10b981; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span id="card-badge-6" class="kube-badge" style="background: #dbeafe; color: #1e40af; font-weight: 700;">Kyverno · Enforce</span>
              <span class="kube-badge" style="background: #ffedd5; color: #9a3412; font-weight: 600; font-size: 0.7rem;">HIGH</span>
            </div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.35rem 0;">Require Non-Root Execution</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              Rejects any pod configuration running as root (UID 0) by validating <code class="kube-code">runAsNonRoot: true</code>, ensuring containers run under unprivileged Unix UIDs.
            </p>

