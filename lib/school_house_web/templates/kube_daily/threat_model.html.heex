          </a>
          <a href="https://kubernetes.io/docs/reference/access-authn-authz/validating-admission-policy/" target="_blank" rel="noopener" class="kube-button kube-button-secondary" style="font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.35rem;">
            ⚙️ In-Tree CEL Docs ↗
          </a>
          <a href="https://open-policy-agent.github.io/gatekeeper/website/docs/" target="_blank" rel="noopener" class="kube-button kube-button-secondary" style="font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.35rem;">
            🛡️ Gatekeeper Docs ↗
          </a>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">

        <!-- Policy Card 1 -->
        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #ef4444; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span id="card-badge-1" class="kube-badge" style="background: #dbeafe; color: #1e40af; font-weight: 700;">Kyverno · Enforce</span>
              <span class="kube-badge" style="background: #fee2e2; color: #991b1b; font-weight: 600; font-size: 0.7rem;">CRITICAL</span>
            </div>
            <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.35rem 0;">Disallow Privileged Containers</h4>
            <p style="font-size: 0.8125rem; color: var(--pele-muted, #64748b); line-height: 1.5; margin: 0;">
              Blocks workloads declaring <code class="kube-code">privileged: true</code> and host namespace sharing (<code class="kube-code">hostPID</code>, <code class="kube-code">hostIPC</code>, <code class="kube-code">hostNetwork</code>) to neutralize container-to-host breakouts (P4 / CVE-2024-21626).
            </p>

            <!-- Engine Switcher -->
            <div style="display: flex; gap: 0.25rem; margin: 0.75rem 0 0.5rem 0; background: #f1f5f9; padding: 0.2rem; border-radius: 0.375rem;">
              <button id="card-btn-1-kyverno" onclick="setCardEngine(1, 'kyverno', 'disallow-privileged-containers')" class="card-engine-btn active" style="flex: 1;">⚡ Kyverno</button>
              <button id="card-btn-1-cel" onclick="setCardEngine(1, 'cel', 'disallow-privileged-containers')" class="card-engine-btn" style="flex: 1;">⚙️ CEL</button>
              <button id="card-btn-1-gatekeeper" onclick="setCardEngine(1, 'gatekeeper', 'disallow-privileged-containers')" class="card-engine-btn" style="flex: 1;">🛡️ Gatekeeper</button>
            </div>

            <!-- Code Preview Snippet -->
            <pre style="margin: 0.5rem 0 0 0; padding: 0.6rem; background: #0b132b; color: #38bdf8; border-radius: 0.375rem; font-size: 0.72rem; line-height: 1.45; overflow-x: auto; border: 1px solid #1e293b;"><code id="card-code-1">pattern:
  spec:
    =(hostPID): false
    containers:
      - securityContext:
          =(privileged): false</code></pre>

            <div style="margin-top: 0.65rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
              <span style="font-size: 0.7rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-weight: 600;">CIS § 5.2.1</span>
              <span style="font-size: 0.7rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-weight: 600;">MITRE T1611</span>
