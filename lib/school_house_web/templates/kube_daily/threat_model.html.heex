        </div>

        <!-- Policy Card 2 -->
        <div class="kube-card" style="padding: 1.25rem; border-radius: 0.75rem; border-top: 4px solid #f97316; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span id="card-badge-2" class="kube-badge" style="background: #dbeafe; color: #1e40af; font-weight: 700;">Kyverno · Enforce</span>
              <span class="kube-badge" style="background: #ffedd5; color: #9a3412; font-weight: 600; font-size: 0.7rem;">HIGH</span>
