                <circle id="scorecard-ring" cx="44" cy="44" r="36" fill="transparent" stroke="#ef4444" stroke-width="8" stroke-dasharray="226.2" stroke-dashoffset="226.2" stroke-linecap="round" style="transition: stroke-dashoffset 0.4s ease, stroke 0.4s ease;" />
