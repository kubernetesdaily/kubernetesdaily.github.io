      detection: `audit-log: verb=get user.username=system:serviceaccount:*`,
      kyverno: `# Kyverno ClusterPolicy: Restrict ServiceAccount Token Automounting
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: restrict-sa-token-automount
