<section class="kube-threat-spotlight px-4 py-14 sm:px-6 lg:px-10 bg-brand-gray-900 text-white relative overflow-hidden border-t border-b border-brand-gray-800" aria-labelledby="threat-model-feature-title">
  <div class="absolute -right-32 -bottom-32 w-96 h-96 rounded-full bg-brand-purple-900 opacity-40 blur-3xl pointer-events-none"></div>
  <div class="kube-section-container relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 pb-8 border-b border-brand-gray-800">
      <div>
